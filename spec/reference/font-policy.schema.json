{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpresentation.org/schema/opf-font-policy/v1",
  "title": "OPF font policy",
  "description": "Schema for spec/reference/font-policy.json (font-fidelity-everywhere FF-31): one row per font family with its license class, viewer availability, whether OPF may embed it, and the openly licensed replacement a renderer previews it with. Reference data for engines, not part of the OPF document contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provisionalDecisions",
    "description",
    "version",
    "measurement",
    "families"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "provisionalDecisions": {
      "description": "The one place provisional owner decisions live. Rows whose replacement names a decision take its family and compatibility from it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note",
        "decisions"
      ],
      "properties": {
        "status": {
          "type": "string",
          "pattern": "provisional"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "replacement",
              "compatibility"
            ],
            "properties": {
              "replacement": {
                "$ref": "#/$defs/family"
              },
              "compatibility": {
                "$ref": "#/$defs/compatibility"
              },
              "metricModeFallback": {
                "description": "Metric-mode registries still preview with this visual replacement (reported as visual) so an earlier metric behaviour does not regress.",
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "corpus",
        "evidence",
        "definition"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "corpus": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "family": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\"'\\\\<>;]+$"
    },
    "compatibility": {
      "enum": [
        "metric",
        "visual"
      ]
    },
    "share": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacement",
        "meanAbsWidthDelta",
        "meanWidthDelta",
        "maxAbsWidthDelta",
        "styles",
        "reference"
      ],
      "properties": {
        "replacement": {
          "$ref": "#/$defs/family"
        },
        "meanAbsWidthDelta": {
          "$ref": "#/$defs/share"
        },
        "meanWidthDelta": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "maxAbsWidthDelta": {
          "$ref": "#/$defs/share"
        },
        "styles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured"
      ],
      "dependentRequired": {
        "sizeAdjust": [
          "sizeAdjustBasis"
        ],
        "lineAscent": [
          "sizeAdjust",
          "lineAscentBasis"
        ],
        "lineAscentMixed": [
          "lineAscent"
        ]
      },
      "properties": {
        "family": {
          "$ref": "#/$defs/family"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "decision": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "disabledFeatures": {
          "description": "OpenType feature tags a renderer must turn off when it shapes and draws this replacement (for example liga and clig for Gelasio, which ligates fi and fl where Georgia does not). The measurement below is taken with them off, and a metric claim holds only with them off.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 ]{4}$"
          }
        },
        "sizeAdjust": {
          "description": "Preview-only font-size multiplier (RR-38). A renderer scales the replacement's font size by this factor when it measures and draws it, so its advances (and, roughly, its glyph size) match the real font's. It applies only when the face drawn is this row's `family`, and never reaches a PPTX or the geometry core composes. Measured as the sum of the real font's shaped advances over the sum of the replacement's, on the script corpus, regular style; `sizeAdjustBasis` records how. Absent means 1.",
          "type": "number",
          "minimum": 0.25,
          "maximum": 2
        },
        "lineAscent": {
          "description": "Preview-only baseline offset (RR-38). Em of the font size from the top of a line box to the baseline in PowerPoint (100 percent line spacing, zero insets, top anchor) when every run of the line is drawn in the real font. A renderer that places baselines one em below the line top (core's convention) moves the replacement's runs up by 1 - lineAscent em. Applies with sizeAdjust, to the face drawn as the row's replacement only.",
          "type": "number",
          "minimum": 0.3,
          "maximum": 1.2
        },
        "lineAscentMixed": {
          "description": "Like lineAscent, for a line that also holds runs in other fonts (a Latin run in a right-to-left line). Absent means lineAscent.",
          "type": "number",
          "minimum": 0.3,
          "maximum": 1.2
        },
        "lineAscentBasis": {
          "description": "How lineAscent was measured (probe, font versions, sizes, the hhea ascent for comparison). Required with lineAscent.",
          "type": "string",
          "minLength": 1
        },
        "sizeAdjustBasis": {
          "description": "How `sizeAdjust` was measured: the corpus, the reference font version, the advance ratio it is rounded from and the ink-height ratio for comparison. Required with `sizeAdjust`.",
          "type": "string",
          "minLength": 1
        },
        "measured": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/measured"
            }
          ]
        },
        "source": {
          "type": "string",
          "format": "uri"
        }
      },
      "if": {
        "properties": {
          "decision": {
            "type": "string"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "family": false,
          "compatibility": false
        }
      },
      "else": {
        "properties": {
          "family": {
            "$ref": "#/$defs/family"
          },
          "compatibility": {
            "$ref": "#/$defs/compatibility"
          }
        },
        "required": [
          "family",
          "compatibility"
        ]
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "licenseClass",
        "license",
        "availability",
        "embeddableByOpf",
        "replacement",
        "sources"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/family"
        },
        "licenseClass": {
          "enum": [
            "open",
            "proprietary-standard",
            "proprietary-nonstandard"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "windows-optional",
              "macos",
              "office",
              "office-cloud"
            ]
          }
        },
        "embeddableByOpf": {
          "type": "boolean"
        },
        "replacement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/replacement"
            }
          ]
        },
        "alternates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/family"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "licenseClass": {
            "const": "open"
          }
        }
      },
      "then": {
        "properties": {
          "embeddableByOpf": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "embeddableByOpf": {
            "const": false
          }
        }
      }
    }
  }
}
