{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpresentation.org/schema/opf-preset-geometry/v1",
  "title": "OPF preset shape geometry",
  "description": "Schema for spec/reference/preset-geometry.json (shapes SH-01): the 187 DrawingML preset shapes of ECMA-376 Part 1 (ST_ShapeType) in the standard's own names and units, generated by scripts/build-preset-geometry.mjs from the standard's presetShapeDefinitions.xml. Reference data for engines, not part of the OPF document contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "version", "source", "errata", "shapes"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "distribution", "url", "commit", "license", "licenseUrl", "notice", "standard", "sha256"],
      "properties": {
        "name": { "type": "string" },
        "distribution": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "const": "Apache-2.0" },
        "licenseUrl": { "type": "string", "format": "uri" },
        "notice": { "type": "string" },
        "standard": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "errata": {
      "description": "Corrections of the standard's file to what PowerPoint draws, each with the value it replaces.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape", "field", "from", "to", "note"],
        "properties": {
          "shape": { "type": "string" },
          "field": { "enum": ["avLst", "gdLst", "ahLst", "cxnLst", "rect", "pathLst"] },
          "index": { "type": "integer", "minimum": 0 },
          "from": {},
          "to": {},
          "note": { "type": "string" }
        }
      }
    },
    "shapes": {
      "type": "object",
      "minProperties": 187,
      "maxProperties": 187,
      "propertyNames": { "pattern": "^[a-zA-Z0-9]+$" },
      "additionalProperties": { "$ref": "#/$defs/shape" }
    }
  },
  "$defs": {
    "value": {
      "description": "A guide name (built-in or defined earlier) or an integer literal, as the standard writes it.",
      "type": "string",
      "pattern": "^(-?[0-9]+|[a-zA-Z0-9]+)$"
    },
    "guide": {
      "description": "[name, formula]: the formula's operator and its operands, space separated.",
      "type": "array",
      "prefixItems": [{ "type": "string" }, { "type": "string", "pattern": "^(\\*/|\\+-|\\+/|\\?:|abs|at2|cat2|cos|max|min|mod|pin|sat2|sin|sqrt|tan|val) " }],
      "minItems": 2,
      "maxItems": 2
    },
    "point": { "type": "array", "items": { "$ref": "#/$defs/value" }, "minItems": 2, "maxItems": 2 },
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pos"],
      "properties": {
        "type": { "enum": ["xy", "polar"] },
        "gdRefX": { "type": "string" },
        "minX": { "$ref": "#/$defs/value" },
        "maxX": { "$ref": "#/$defs/value" },
        "gdRefY": { "type": "string" },
        "minY": { "$ref": "#/$defs/value" },
        "maxY": { "$ref": "#/$defs/value" },
        "gdRefR": { "type": "string" },
        "minR": { "$ref": "#/$defs/value" },
        "maxR": { "$ref": "#/$defs/value" },
        "gdRefAng": { "type": "string" },
        "minAng": { "$ref": "#/$defs/value" },
        "maxAng": { "$ref": "#/$defs/value" },
        "pos": { "$ref": "#/$defs/point" }
      }
    },
    "command": {
      "type": "array",
      "prefixItems": [{ "enum": ["moveTo", "lnTo", "arcTo", "quadBezTo", "cubicBezTo", "close"] }],
      "items": { "$ref": "#/$defs/value" },
      "minItems": 1,
      "maxItems": 7
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "fill": { "enum": ["norm", "none", "lighten", "lightenLess", "darken", "darkenLess"] },
        "stroke": { "type": "boolean" },
        "extrusionOk": { "type": "boolean" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" }, "minItems": 1 }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathLst"],
      "properties": {
        "avLst": { "type": "array", "items": { "$ref": "#/$defs/guide" } },
        "gdLst": { "type": "array", "items": { "$ref": "#/$defs/guide" } },
        "ahLst": { "type": "array", "items": { "$ref": "#/$defs/handle" } },
        "cxnLst": {
          "type": "array",
          "items": { "type": "array", "items": { "$ref": "#/$defs/value" }, "minItems": 3, "maxItems": 3 }
        },
        "rect": { "type": "array", "items": { "$ref": "#/$defs/value" }, "minItems": 4, "maxItems": 4 },
        "pathLst": { "type": "array", "items": { "$ref": "#/$defs/path" }, "minItems": 1 }
      }
    }
  }
}
