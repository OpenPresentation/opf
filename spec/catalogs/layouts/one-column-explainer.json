{
  "$schema": "https://openpresentation.org/schema/opf-layout/v1",
  "id": "one-column-explainer",
  "name": "One_Column_Explainer",
  "summary": "A single block of body text with a headline. Use when a concept needs paragraph-length explanation, not bullets.",
  "description": "A single block of body text with a headline. Use when a concept needs paragraph-length explanation, not bullets.",
  "contentType": "Text",
  "contentMultiple": "1x",
  "contentAlignment": "Center",
  "contentBox": false,
  "contentTypeChartPrimary": "None",
  "contentTypeImageFill": "None",
  "contentTypeListBullet": "None",
  "contentTypeListHeading": false,
  "slideTitle": true,
  "slideSubtitle": false,
  "slideTitleAlignment": "Center",
  "slideImage": false,
  "slideImageAlignment": "None",
  "slideLayoutDirection": "Horizontal",
  "placeholders": [
    {
      "type": "title"
    },
    {
      "type": "text"
    }
  ],
  "tags": [
    "Narrative",
    "Explanation",
    "Body Copy"
  ],
  "preview": {}
}
