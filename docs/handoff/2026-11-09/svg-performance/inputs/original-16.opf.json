    {
      "id": "battery",
      "layout": "chart-beside",
      "section": "Battery",
      "title": "Pro Max makes the biggest battery leap yet",
      "blocks": [
        {
          "chart": {
            "type": "column",
            "data": {
              "dataset": "video-playback"
            },
            "alt": "Video playback rises from 33 to 36 hours on the Pro and from 39 to 45 hours on the Pro Max.",
            "highlight": {
              "categories": [
                "iPhone 18 Pro Max"
              ]
            }
          },
          "caption": "Video playback, hours; eSIM-only iPhone 18 Pro models with the larger battery"
        },
        {
          "blocks": [
            {
              "metric": {
                "value": 45,
                "unit": "h",
                "label": "Pro Max video playback",
                "icon": "lucide:battery-full"
              }
            },
            {
              "metric": {
                "value": "50%",
                "label": "Charge in about 15 minutes",
                "icon": "lucide:zap"
              }
            }
          ],
          "composition": {
            "mode": "column"
          }
        }
      ],
      "notes": "Battery is the other headline. eSIM-only models carry a larger battery: 36 hours of video playback on the Pro, matching last year's Pro Max, and 45 hours on the Pro Max, which Apple calls the largest generational increase ever on iPhone. Fast charging reaches 50 percent in about 15 minutes. The 17 Pro figures are Apple's 2025 numbers."
    },
