    {
      "id": "lineup",
      "layout": "statement",
      "section": "Opening",
      "design": {
        "variant": "dark1"
      },
      "title": "Pro first. The rest follows in spring.",
      "text": [
        {
          "text": "On September 9, 2026 Apple announced the iPhone 18 Pro, iPhone 18 Pro Max and the foldable iPhone Duo, with no standard iPhone 18 beside them.",
          "cite": "macrumors"
        },
        {
          "text": " The iPhone 18 and 18e are expected in spring 2027.",
          "cite": "techadvisor"
        }
      ],
      "notes": "The cycle changed this year. Only the Pro models and the foldable shipped in the fall; the standard iPhone 18 and the 18e are expected in spring 2027. So when we say iPhone 18 today, we mean the Pro."
    },
    {
      "id": "headlines",
      "section": "Opening",
      "title": "Four headlines",
      "items": [
        {
          "text": "Camera",
          "description": "48MP Fusion Main camera with a variable aperture and new Pro controls.",
          "icon": "lucide:aperture"
        },
        {
          "text": "Performance",
          "description": "A20 Pro, Apple's first 2nm chip, with a redesigned vapor chamber.",
          "icon": "lucide:cpu"
        },
        {
          "text": "Battery",
          "description": "Up to 45 hours of video playback on the Pro Max, Apple's largest leap yet.",
          "icon": "lucide:battery-charging"
        },
        {
          "text": "Intelligence",
          "description": "Siri AI on Apple Intelligence, shipping with iOS 27 on September 14.",
          "icon": "lucide:sparkles"
        }
      ],
      "notes": "Four headlines carry the launch: the camera, the chip, the battery, and Siri AI. One slide each."
    },
    {
      "id": "a20-numbers",
      "layout": "metrics",
      "section": "Performance",
      "title": "A20 Pro by the numbers",
      "blocks": [
        {
          "metric": {
            "value": 2,
            "unit": "nm",
            "label": "Process node, a first for Apple",
            "icon": "lucide:cpu"
          }
        },
        {
          "metric": {
            "value": "40%",
            "label": "Faster 7-core GPU vs A19 Pro",
            "icon": "lucide:gauge"
          }
        },
        {
          "metric": {
            "value": "50%",
            "label": "More memory bandwidth",
            "icon": "lucide:arrow-left-right"
          }
        },
        {
          "metric": {
            "value": "2×",
            "label": "On-device AI processing",
            "icon": "lucide:brain"
          }
        }
      ],
      "notes": "A20 Pro is Apple's first 2 nanometer chip. The new 7-core GPU is up to 40 percent faster than A19 Pro, memory bandwidth is up 50 percent, and dual 16-core Neural Engines double on-device AI processing."
    },
