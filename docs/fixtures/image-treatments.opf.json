{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Image treatments reference",
  "description": "One slide per pptx.gallery image treatment, expressed with 0.15 image backgrounds and image blocks (fit, treatments and placement). See docs/image-treatments.md for support status and gaps.",
  "assets": {
    "hero": {
      "src": "data:image/png;base64,",
      "alt": "Project-authored posterized landscape with a sun",
      "mediaType": "image/png"
    }
  },
  "design": {
    "theme": "classic"
  },
  "slides": [
    {
      "id": "full-bleed",
      "title": "Full-Bleed",
      "subtitle": "pptx.gallery image-treatments/full-bleed",
      "design": {
        "background": {
          "type": "image",
          "src": "asset:hero",
          "overlay": {
            "color": "dark1",
            "opacity": 0.2
          }
        }
      }
    },
    {
      "id": "text-overlay",
      "title": "Text Overlay",
      "subtitle": "pptx.gallery image-treatments/text-overlay",
      "design": {
        "background": {
          "type": "image",
          "src": "asset:hero",
          "overlay": {
            "color": "dark1",
            "opacity": 0.55
          }
        }
      }
    },
    {
      "id": "side-by-side",
      "title": "Side-by-Side",
      "subtitle": "pptx.gallery image-treatments/side-by-side",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "cover",
          "placement": {
            "edge": "left",
            "size": 0.46
          }
        }
      ]
    },
    {
      "id": "caption-overlay",
      "title": "Caption Overlay",
      "subtitle": "pptx.gallery image-treatments/caption-overlay",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "cover",
          "overlay": {
            "color": "dark1",
            "opacity": 0.75,
            "edge": "bottom",
            "size": 0.25
          }
        }
      ]
    },
    {
      "id": "masked-shape",
      "title": "Masked Shape",
      "subtitle": "pptx.gallery image-treatments/masked-shape",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "cover",
          "aspectRatio": 1.1547,
          "shape": "hexagon",
          "placement": {
            "edge": "right",
            "inset": true
          }
        }
      ]
    },
    {
      "id": "circular-crop",
      "title": "Circular Crop",
      "subtitle": "pptx.gallery image-treatments/circular-crop",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "cover",
          "shape": "circle",
          "placement": {
            "edge": "left",
            "size": 0.4,
            "inset": true
          }
        }
      ]
    },
    {
      "id": "rounded-card",
      "title": "Rounded Card",
      "subtitle": "pptx.gallery image-treatments/rounded-card",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "cover",
          "shape": "rounded",
          "cornerRadius": 0.05,
          "border": {
            "color": "accent5",
            "width": 1
          }
        }
      ]
    },
    {
      "id": "duotone",
      "title": "Duotone",
      "subtitle": "pptx.gallery image-treatments/duotone",
      "design": {
        "background": {
          "type": "image",
          "src": "asset:hero",
          "recolor": {
            "dark": "accent1",
            "light": "light1"
          }
        }
      }
    },
    {
      "id": "background-blur",
      "title": "Background Blur",
      "subtitle": "pptx.gallery image-treatments/background-blur",
      "design": {
        "contentBox": true,
        "background": {
          "type": "image",
          "src": "asset:hero",
          "overlay": {
            "color": "light1",
            "opacity": 0.4
          }
        }
      }
    },
    {
      "id": "image-strip",
      "title": "Image Strip",
      "subtitle": "pptx.gallery image-treatments/image-strip",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "cover",
          "placement": {
            "edge": "bottom",
            "size": 0.3
          }
        }
      ]
    },
    {
      "id": "collage-grid",
      "title": "Collage Grid",
      "design": {
        "imageFit": "cover"
      },
      "composition": {
        "mode": "grid",
        "columns": 2
      },
      "blocks": [
        {
          "image": "asset:hero"
        },
        {
          "image": "asset:hero"
        },
        {
          "image": "asset:hero"
        },
        {
          "image": "asset:hero"
        }
      ]
    },
    {
      "id": "device-frame",
      "title": "Device Frame",
      "subtitle": "pptx.gallery image-treatments/device-frame",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "cover",
          "aspectRatio": 0.5,
          "shape": "rounded",
          "cornerRadius": 0.12,
          "border": {
            "color": "dark1",
            "width": 12
          },
          "placement": {
            "edge": "right",
            "inset": true
          }
        }
      ]
    },
    {
      "id": "cutout-subject",
      "title": "Cutout Subject",
      "subtitle": "pptx.gallery image-treatments/cutout-subject",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "contain",
          "placement": {
            "edge": "right"
          }
        }
      ]
    },
    {
      "id": "watermark",
      "title": "Watermark",
      "subtitle": "pptx.gallery image-treatments/watermark",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "contain",
          "opacity": 0.1,
          "recolor": "grayscale"
        }
      ]
    },
    {
      "id": "cinematic-crop",
      "title": "Cinematic Crop",
      "subtitle": "pptx.gallery image-treatments/cinematic-crop",
      "blocks": [
        {
          "image": "asset:hero",
          "fit": "cover",
          "aspectRatio": 2.39
        }
      ],
      "design": {
        "background": "dark1"
      }
    }
  ],
  "catalogs": {
    "default": {
      "source": "https://www.pptx.gallery",
      "themes": {
        "classic": {
          "name": "Classic",
          "background": {
            "type": "theme",
            "slot": "light1"
          },
          "colorScheme": "cool-horizon",
          "description": "A timeless, clean, and versatile theme with balanced color contrasts and classic typography. Ideal for professional, readable presentations.",
          "fontScheme": "tenorite",
          "dimensions": "widescreen"
        }
      },
      "colorSchemes": {
        "cool-horizon": {
          "name": "Cool Horizon",
          "accent1": "#2874A6",
          "accent2": "#1B4F72",
          "accent3": "#5499C7",
          "accent4": "#7BDBB2",
          "accent5": "#3AC67A",
          "accent6": "#24A89E",
          "dark1": "#000000",
          "dark2": "#011842",
          "followedHyperlink": "#551A8B",
          "hyperlink": "#0000EE",
          "light1": "#FFFFFF",
          "light2": "#F0F0F0",
          "summary": "Cool blue-green palette tuned for professional business decks.",
          "description": "A balanced cool-toned scheme with deep navy, business blues, and teal accents. It works well across strategy, finance, and technical narratives.",
          "tags": [
            "professional",
            "trustworthy",
            "calm",
            "technical",
            "versatile"
          ]
        }
      },
      "fontSchemes": {
        "tenorite": {
          "name": "Tenorite",
          "app": "powerpoint",
          "languageFamily": "latin",
          "languages": [],
          "major": "Tenorite Display",
          "minor": "Tenorite",
          "textSample": "Rounded modern tone",
          "type": "sans-serif",
          "description": "Tenorite is a sans serif OPF font scheme for Latin presentations, using Tenorite Display for headings with Tenorite for body text."
        }
      }
    }
  }
}
