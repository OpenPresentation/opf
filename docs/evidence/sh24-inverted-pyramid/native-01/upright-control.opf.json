{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Inverted pyramids",
  "description": "Narrow an ordered set from the broad starting pool to a final decision. The same geometry draws in the preview and as editable PowerPoint shapes; live Inverted Pyramid SmartArt is not qualified.",
  "language": "en-US",
  "design": {
    "background": "light1"
  },
  "slides": [
    {
      "id": "shortlist",
      "layout": "pyramid",
      "title": "From possibilities to a decision",
      "items": [
        "Possibilities",
        "Qualified options",
        "Shortlist",
        "Decision"
      ]
    },
    {
      "id": "evidence",
      "layout": "pyramid",
      "title": "Narrow the next investment",
      "items": [
        "Gather proposals from every team",
        "Check the evidence and delivery capacity",
        "Compare the qualified options",
        "Choose the next pilot"
      ]
    },
    {
      "id": "workstreams",
      "layout": "pyramid",
      "title": "Keep the work behind each decision",
      "blocks": [
        {
          "items": [
            "Gather proposals",
            "Keep every team in the starting pool"
          ]
        },
        {
          "items": [
            "Test the assumptions",
            "Check delivery capacity"
          ]
        },
        {
          "items": [
            "Compare the shortlist",
            "Record the tradeoffs"
          ]
        },
        {
          "items": [
            "Choose the pilot",
            "Name the owner"
          ]
        }
      ]
    }
  ],
  "catalogs": {
    "default": {
      "source": "https://www.pptx.gallery",
      "layouts": {
        "pyramid": {
          "name": "Pyramid",
          "summary": "Levels that build on each other, as a pyramid, the first at the top.",
          "tags": [
            "Groups of items"
          ],
          "direction": "column",
          "regions": [
            {
              "name": "title"
            },
            {
              "name": "levels",
              "accepts": [
                "list"
              ],
              "role": "primary",
              "flow": "none",
              "arrangement": "pyramid"
            }
          ],
          "description": "Show a hierarchy of 1 to 8 levels, from the narrow top (the peak, the few, the goal) to the broad base (the foundation, the many). Write one short list entry per level, the top level first.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/pyramid.svg"
          }
        }
      }
    }
  }
}
