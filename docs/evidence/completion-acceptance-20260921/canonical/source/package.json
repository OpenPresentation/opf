{
  "name": "pptx-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:opf-spec": "node --experimental-strip-types scripts/sync-opf-spec.ts",
    "predev": "pnpm sync:opf-spec && convex dev --until-success",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "pnpm prepare:opf-browser && next dev",
    "dev:backend": "convex dev",
    "build": "node --version && pnpm prepare:opf-browser && pnpm sync:opf-spec && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm sync:opf-spec && vitest run",
    "test:e2e": "playwright test",
    "test:playground": "pnpm sync:opf-spec && vitest run test/playground.test.ts",
    "prepare:opf-browser": "node scripts/prepare-opf-browser.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.102",
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.2",
    "@clerk/themes": "^2.4.57",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@openpresentation/opf": "0.11.0",
    "@openpresentation/opf-editor": "0.8.0",
    "@openpresentation/opf-pptx": "0.9.1",
    "@openpresentation/opf-render": "0.9.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "ai": "7.0.99",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "5.11.1",
    "js-yaml": "5.4.1",
    "jszip": "3.10.2",
    "lucide-react": "^1.45.0",
    "monaco-editor": "^0.56.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "next": "16.3.5",
    "pptxgenjs": "^4.0.1",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "swagger-ui-react": "^5.32.15",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "engines": {
    "node": "24.x"
  }
}
