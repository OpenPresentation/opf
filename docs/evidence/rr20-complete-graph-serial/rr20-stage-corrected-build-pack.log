          "test:native-picture-edit-controls": "node test/compare-native-picture-edit-controls.mjs",
          "test:native-font-embed-controls": "node test/native-font-embed-controls.mjs",
          "test:native-mixed-edit-controls": "node test/native-mixed-edit-controls.mjs",
          "test:native-font-inventory-controls": "node test/native-font-inventory-controls.mjs",
          "test:zip-date": "node test/zip-date.mjs",
