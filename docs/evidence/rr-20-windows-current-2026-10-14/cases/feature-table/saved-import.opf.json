{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Layout fixture table",
  "slides": [
    {
      "title": "Compare outcomes on consistent measures",
      "subtitle": "Illustrative example • fictional data",
      "blocks": [
        {
          "table": {
            "columns": [
              "Team",
              {
                "name": "Participants",
                "format": "0"
              },
              {
                "name": "Completion",
                "format": "0%"
              },
              {
                "name": "Median time (min)",
                "format": "0.0"
              }
            ],
            "rows": [
              [
                "A",
                28,
                0.89,
                5.8
              ],
              [
                "B",
                24,
                0.79,
                6.7
              ]
            ]
          },
          "region": "table"
        },
        {
          "text": "Test with two teams for six weeks. Measure task completion and time before deciding what to scale.",
          "region": "note"
        }
      ],
      "layout": "table"
    }
  ],
  "design": {
    "fontScheme": "roboto",
    "background": "light1"
  },
  "catalogs": {
    "default": {
      "source": "https://www.pptx.gallery",
      "layouts": {
        "table": {
          "name": "Table",
          "summary": "A table across the slide, with an optional note.",
          "tags": [
            "Visuals"
          ],
          "areas": [
            [
              "title"
            ],
            [
              "table"
            ],
            [
              "note"
            ]
          ],
          "columns": [
            1
          ],
          "rows": [
            "auto",
            1,
            "auto"
          ],
          "regions": {
            "table": {
              "accepts": [
                "table"
              ],
              "role": "primary",
              "flow": "column"
            },
            "note": {
              "accepts": [
                "text"
              ],
              "role": "supporting",
              "flow": "none"
            }
          },
          "description": "Present structured data that benefits from precise comparison. Use clear row and column headings and concise cell content.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/table.svg"
          }
        }
      }
    }
  }
}
