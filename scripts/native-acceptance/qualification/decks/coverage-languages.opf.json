{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Coverage: languages, scripts and digits",
  "description": "RR-105 format coverage: slide-level languages as tags and as inline records, right-to-left Arabic and Hebrew, Japanese and Chinese, numbering systems chosen by a -u-nu- tag, and a run in another language.",
  "language": "en-US",
  "design": {
    "background": "light1"
  },
  "slides": [
