        {
          "text": "ارتفعت الإيرادات بنسبة ١٨ في المئة هذا العام."
        },
        {
          "chart": {
            "type": "column",
            "data": {
              "columns": [
                "الربع",
                "الشمال",
                "الجنوب"
              ],
              "rows": [
                [
                  "الربع الأول",
                  12,
                  9
                ],
                [
                  "الربع الثاني",
                  18,
                  11
                ],
                [
                  "الربع الثالث",
                  25,
                  14
                ]
              ]
            },
            "legend": "top",
            "dataLabels": true
          }
        }
      ]
    },
    {
      "id": "arabic-latin-digits",
      "language": "ar-EG-u-nu-latn",
      "title": "الأرقام اللاتينية في شريحة عربية",
