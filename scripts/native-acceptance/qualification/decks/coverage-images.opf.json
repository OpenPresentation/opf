    },
    {
      "id": "callouts",
      "title": "Callouts on a picture",
      "image": {
        "src": "asset:photo",
        "alt": "Harbor at dusk",
        "callouts": [
          {
            "text": "New cranes",
            "x": 0.1,
            "y": 0.15,
            "width": 0.3,
            "height": 0.15
          },
          {
            "text": "Berth 4 opens in spring",
            "x": 0.6,
            "y": 0.7,
            "width": 0.35,
            "height": 0.15
          }
        ]
      }
    },
    {
      "id": "video-root",
      "type": "video",
      "title": "Watch the two-minute walkthrough",
      "video": "asset:walkthrough",
      "caption": "Recorded with the October release."
    },
    {
      "id": "video-block",
      "title": "A video beside its talking points",
      "blocks": [
        {
          "type": "video",
          "video": {
            "src": "https://example.com/media/setup.mp4",
            "alt": "Setup video",
            "title": "Setup in five minutes"
          },
          "caption": [
            {
              "text": "Setup",
              "bold": true
            },
            " in five minutes"
          ]
        },
        {
          "bullets": [
            "Install the app",
            "Connect the account",
            "Invite the team"
          ]
        }
      ]
    },
    {
      "id": "captions-tables-charts",
      "title": "Captions on a chart and a table",
      "blocks": [
        {
          "chart": {
            "type": "column",
            "data": {
              "columns": [
                "Year",
                "Ships"
              ],
              "rows": [
                [
                  "2024",
                  310
                ],
                [
                  "2025",
                  344
                ],
                [
                  "2026",
                  391
                ]
              ]
            }
          },
          "caption": "Ships handled per year"
        },
        {
          "table": {
            "columns": [
              "Berth",
              "Depth"
            ],
            "rows": [
              [
                "North",
                "16 m"
              ],
              [
                "South",
                "14 m"
              ]
            ]
          },
          "caption": {
            "text": [
              "Berth depths at ",
              {
                "text": "low tide",
                "italic": true
              }
            ],
            "align": "start"
          }
        }
      ]
