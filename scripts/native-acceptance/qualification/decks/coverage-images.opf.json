                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "team-side",
      "title": "Pictures beside the names",
      "blocks": [
        {
          "type": "group",
          "blocks": [
            {
              "image": {
                "src": "./assets/alice.png",
