{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Coverage: images, captions and video",
  "description": "RR-105 format coverage: image payloads and assets, fit, focus, recolor, overlays, placement, team portraits, captions in every form, image strokes and opacity, and video placeholders.",
  "language": "en-US",
  "design": {
    "background": "light1",
    "imageFit": "contain"
  },
  "assets": {
    "photo": {
      "src": "./assets/cover-image.png",
      "alt": "Harbor at dusk with cranes and containers",
      "title": "Harbor",
      "description": "Stock photo used across the deck",
      "mediaType": "image/png"
    },
    "product": "./assets/product-shot.png",
    "walkthrough": {
      "src": "https://example.com/media/walkthrough.mp4",
      "alt": "Product walkthrough video",
      "title": "Product walkthrough",
      "mediaType": "video/mp4"
    }
  },
  "slides": [
    {
      "id": "image-object",
      "type": "image",
      "title": "A picture with alt text and a caption",
      "image": {
        "src": "asset:photo",
        "alt": "Harbor at dusk with cranes and containers",
        "mediaType": "image/png",
        "title": "Harbor",
        "description": "Our main terminal, photographed in October"
      },
      "caption": {
        "text": "The north terminal handles 60 percent of volume.",
        "position": "below",
        "align": "center"
      }
    },
    {
      "id": "fit-modes",
      "title": "Cover, contain, stretch and automatic fit",
      "blocks": [
        {
          "image": {
            "src": "asset:product",
            "alt": "Product shot, cropped to fill"
          },
          "fit": "cover"
        },
        {
          "image": {
            "src": "asset:product",
            "alt": "Product shot, whole"
          },
          "fit": "contain"
        },
        {
          "image": {
            "src": "asset:product",
            "alt": "Product shot, stretched"
          },
          "fit": "stretch"
        },
        {
          "image": {
            "src": "asset:product",
            "alt": "Product shot, engine choice"
          },
          "fit": "auto"
        }
      ]
    },
    {
      "id": "focus-recolor",
      "title": "Focus points and recolored pictures",
      "blocks": [
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor cropped to the cranes"
          },
          "fit": "cover",
          "focus": {
            "x": 0.8,
            "y": 0.3
          },
          "caption": "Focus on the cranes"
        },
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor in gray"
          },
          "recolor": "grayscale",
          "caption": [
            "In ",
            {
              "text": "grayscale",
              "italic": true
            }
          ]
        },
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor in brand colors"
          },
          "recolor": {
            "dark": "dark2",
            "light": {
              "color": "accent1",
              "lighten": 0.7
            }
          },
          "caption": {
            "text": "Duotone in brand colors",
            "position": "above",
            "align": "end"
          }
        }
      ]
    },
    {
      "id": "overlay-bands",
      "title": "Color bands over a picture",
      "blocks": [
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor with a top band"
          },
          "overlay": {
            "color": "dark1",
            "opacity": 0.5,
            "edge": "top",
            "size": 0.3
          }
        },
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor with a bottom band"
          },
          "overlay": {
            "color": "accent1",
            "opacity": 0.6,
            "edge": "bottom",
            "size": 0.25
          }
        },
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor with a start band"
          },
          "overlay": {
            "color": "#000000",
            "opacity": 0.4,
            "edge": "start",
            "size": 0.4
          }
        },
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor with an end band"
          },
          "overlay": {
            "color": "accent2",
            "opacity": 0.5,
            "edge": "end"
          }
        }
      ]
    },
    {
      "id": "placement-start",
      "title": "A picture placed at the start edge",
      "blocks": [
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor at dusk"
          },
          "placement": {
            "edge": "start",
            "size": 0.4,
            "inset": true
          }
        },
        {
          "text": "Volume through the north terminal grew for the sixth quarter in a row, and the new cranes cut unloading time by a fifth."
        }
      ]
    },
    {
      "id": "placement-end",
      "title": "A picture placed at the end edge",
      "blocks": [
        {
          "image": {
            "src": "asset:product",
            "alt": "Product shot"
          },
          "placement": {
            "edge": "end",
            "size": 0.5
          }
        },
        {
          "items": [
            "Lighter frame",
            "Twice the battery",
            "Same price"
          ]
        }
      ]
    },
    {
      "id": "placement-top",
      "title": "A banner picture along the top",
      "blocks": [
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor panorama"
          },
          "placement": {
            "edge": "top",
            "size": 0.45
          }
        },
        {
          "text": "Three new berths open in the spring."
        }
      ]
    },
    {
      "id": "placement-bottom",
      "title": "A strip picture along the bottom",
      "blocks": [
        {
          "text": "The team behind the harbor upgrade met every milestone this year."
        },
        {
          "image": {
            "src": "asset:photo",
            "alt": "Harbor strip"
          },
          "placement": {
            "edge": "bottom",
            "size": 0.35,
            "inset": false
          }
        }
      ]
    },
    {
      "id": "image-style",
      "title": "A framed, translucent picture",
      "blocks": [
        {
          "image": {
            "src": "asset:product",
            "alt": "Product shot with a frame"
          },
          "aspectRatio": 1.5,
          "stroke": {
            "color": "accent1",
            "width": 3
          },
          "opacity": 0.85
        },
        {
          "image": {
            "src": "asset:product",
            "alt": "Product shot in a circle"
          },
          "shape": "ellipse",
          "aspectRatio": 1
        }
      ]
    },
    {
      "id": "team-top",
      "title": "Pictures across the top of each card",
      "blocks": [
        {
          "type": "group",
          "blocks": [
            {
              "image": {
                "src": "./assets/alice.png",
                "alt": "Portrait of Alice Moreno"
              },
              "portrait": "top",
              "focus": {
                "x": 0.5,
                "y": 0.3
              }
            },
            {
              "items": [
                {
                  "text": "Alice Moreno",
                  "description": "Operations"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "blocks": [
            {
              "image": {
                "src": "./assets/alice.png",
                "alt": "Portrait of Ben Okafor"
              },
              "portrait": "top"
            },
            {
              "items": [
                {
                  "text": "Ben Okafor",
