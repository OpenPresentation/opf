    {
      "id": "team-avatar",
      "title": "Small avatars over the names",
      "blocks": [
        {
          "type": "group",
          "blocks": [
            {
              "image": {
                "src": "./assets/alice.png",
                "alt": "Portrait of Alice Moreno"
              },
              "portrait": "avatar"
            },
            {
              "items": [
                {
                  "text": "Alice Moreno",
