              },
              "portrait": "avatar"
            },
            {
              "items": [
                {
                  "text": "Ben Okafor",
                  "description": "Finance"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "blocks": [
            {
              "image": {
                "src": "./assets/alice.png",
