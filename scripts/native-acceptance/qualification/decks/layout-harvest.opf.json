  "name": "Qualification: layout harvest waves 7 and 8",
  "description": "v0.33 qualification: statements, message surfaces, icons, icon cards and text tiles, portraits, picture bands, steppers, figure rows, run-in heads, table-note grids, heading tracks, closing and chart labels.",
  "language": "en-US",
  "slides": [
    {
      "id": "cover-picture",
      "layout": "cover",
      "title": "Building a faster supply network",
      "subtitle": "Board strategy review, October 2026",
      "design": {
        "background": {
          "type": "image",
          "src": "assets/cover-image.png"
        }
      }
    },
    {
      "id": "statement",
      "layout": "statement",
      "title": "We will halve the time from order to delivery by next autumn",
      "blocks": [
        {
          "region": "message",
          "text": "Three changes get us there: regional stock, one planning calendar and carriers we measure every week."
        }
      ]
    },
    {
      "id": "icon-list",
      "title": "What we will cover",
      "items": [
        {
          "text": "Faster delivery",
          "icon": "lucide:truck",
          "description": "Regional stock so most orders ship the same day from a warehouse near the customer, with the slow lanes moved to rail."
        },
        {
          "text": "One calendar",
          "icon": "lucide:calendar",
          "description": "Sales, planning and finance work from one weekly plan, reviewed every Monday morning with the regional leads."
        },
        {
          "text": "Measured carriers",
          "icon": "lucide:gauge",
          "description": "Every carrier gets a weekly scorecard on time, damage and cost, published to the whole team."
        }
      ]
    },
    {
      "id": "display-message",
      "title": "Why it matters",
      "text": [
        "Customers do not buy software. ",
        {
          "text": "They buy fewer bad Mondays.",
          "bold": true
        }
      ]
    },
    {
      "id": "icon-cards",
      "title": "Four commitments",
      "items": [
        {
          "text": "Ship the same day",
          "icon": "lucide:truck"
        },
        {
          "text": "Plan every Monday",
          "icon": "lucide:calendar"
        },
        {
          "text": "Measure carriers",
          "icon": "lucide:gauge"
        },
        {
          "text": "Protect the margin",
          "icon": "lucide:shield-check"
        }
      ]
    },
