    {
      "id": "section-picture",
      "layout": "section",
      "tag": "Part 2",
      "title": "Where the network grows",
      "subtitle": "Three regions, one plan",
      "design": {
        "background": {
          "type": "image",
          "src": "assets/context-photo.png",
          "textPlacement": "panel"
