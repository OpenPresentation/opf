    {
      "id": "stepper",
      "layout": "process",
      "title": "Four steps to the new network",
      "blocks": [
        {
          "region": "steps",
          "items": [
            {
              "text": "Pick the hubs",
              "description": "Choose four sites near our largest customers."
            }
          ],
          "numbering": {
            "style": "arabic",
            "start": 1
          }
        },
        {
          "region": "steps",
          "items": [
            {
              "text": "Move the stock",
              "description": "Move the 400 fastest items into the hubs."
            }
          ],
          "numbering": {
            "style": "arabic",
            "start": 2
          }
        },
        {
          "region": "steps",
          "items": [
            {
              "text": "Switch the carriers",
              "description": "Contract two carriers per region on scorecards."
            }
          ],
          "numbering": {
            "style": "arabic",
            "start": 3
          }
        },
        {
          "region": "steps",
          "items": [
            {
              "text": "Review every week",
              "description": "Read the scorecards and adjust the plan."
            }
          ],
          "numbering": {
            "style": "arabic",
            "start": 4
          }
        }
      ]
    },
    {
      "id": "figure-row",
      "layout": "two-column",
      "title": "The cost of slow paperwork",
      "blocks": [
        {
          "items": [
            {
              "text": "62 minutes a day",
              "description": "Average time technicians spend on forms after each visit"
            },
            {
              "text": "1 in 6 reports",
              "description": "Sent back for missing details, which doubles the effort"
            },
            {
              "text": "9 days",
              "description": "Typical delay before a completed job can be invoiced"
            }
          ]
        },
        {
          "text": "Digital forms remove the rework and let us invoice the day the job closes."
        }
      ]
    },
    {
      "id": "run-in",
      "layout": "comparison",
      "title": "Choose the smallest useful test",
      "blocks": [
        {
          "region": "first",
          "text": "Option A: focused pilot\nTwo teams, six weeks. Low setup cost and a clear baseline."
        },
        {
          "region": "second",
          "text": "Option B: broad rollout\nAll teams, three months. Wider reach with greater coordination needs."
        },
        {
          "region": "verdict",
          "text": "Recommendation: establish the evidence with Option A before committing to Option B."
        }
      ]
    },
    {
      "id": "table-note",
      "title": "Carrier scorecard",
