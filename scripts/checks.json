{
  "schema": 1,
  "description": "Which root scripts scripts/run-checks.mjs runs for `pnpm test` (RR-46). Every `check:*` script runs unless it is listed in exclude; include lists the other scripts that are part of `pnpm test`. A new check:* script needs no entry here. The excluded checks have their own CI steps. RR-57: check:changed is excluded because it runs a selection of these checks for `pnpm check:changed`; its \"changed\" section maps changed paths to the checks to run: always (every run), and rules {match: path prefixes ending in / or exact files, run: check scripts}. A check:* script whose command names a changed file also runs.",
  "include": [
    "test:gallery-base-fonts",
    "test:gallery-lazy-fonts",
    "test:gallery-script-fonts"
  ],
  "exclude": [
    "check:breaking",
    "check:changed",
    "check:examples",
    "check:quarantine"
  ],
  "changed": {
    "always": ["check:changes"],
    "rules": [
      {"match": ["scripts/published-matrix/parity-work-directory.mjs", "scripts/published-matrix/installed-parity.mjs"], "run": ["check:parity-work-directory"]},
      {"match": ["scripts/publish-source.mjs", ".github/workflows/npm-publish.yml", ".github/workflows/cli-publish.yml"], "run": ["check:publish-source"]},
      {"match": ["scripts/ci-evidence.mjs", "scripts/ci-evidence.json", ".github/workflows/npm-publish.yml", ".github/workflows/cli-publish.yml"], "run": ["check:ci-evidence"]},
      {"match": ["scripts/release-prep.mjs", "scripts/candidate-gallery-results.mjs", ".github/workflows/opf-ci.yml", ".github/workflows/ecosystem-ci.yml"], "run": ["check:release-prep"]},
      {"match": ["scripts/measure-font-replacements.mjs", "scripts/measure-font-replacements.test.mjs"], "run": ["check:font-measurements"]},
      {"match": ["docs/programs/font-fidelity-everywhere/gallery-support/parity/build.ps1", "docs/programs/font-fidelity-everywhere/gallery-support/parity/run.ps1"], "run": ["check:parity-wrappers"]},
      {"match": ["docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/render-api.mjs", "docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/font-availability.mjs", "docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/parity.mjs"], "run": ["check:audit-render-api"]},
      {"match": ["scripts/test-registry-fidelity.mjs", "scripts/registry-fidelity-archive.mjs"], "run": ["check:registry-fidelity-archive"]},
      {"match": ["scripts/measurement-policy.mjs", "scripts/fixtures/editor-scheduled-measurement.json"], "run": ["check:pr-gate", "check:release-train"]},
      {"match": ["scripts/release-train.mjs", "scripts/ci-evidence.mjs", "scripts/release-prep.mjs"], "run": ["check:release-train"]},
      {"match": ["scripts/native-acceptance/"], "run": ["check:native-acceptance"]},
      {"match": ["scripts/pack-ecosystem.mjs", "scripts/ecosystem-preview-plan.mjs", "scripts/ecosystem-preview-plan.test.mjs"], "run": ["check:preview-packaging"]},
      {"match": ["scripts/candidate-gallery.mjs", "scripts/candidate-gallery.test.mjs", "scripts/candidate-gallery-pack.mjs", "scripts/candidate-gallery-pack.test.mjs", "scripts/pack-cli-candidate.mjs", "scripts/candidate-gallery-results.mjs", "scripts/candidate-gallery-results.test.mjs", "scripts/candidate-gallery-build.mjs", "scripts/candidate-gallery-control.mjs", "scripts/candidate-gallery-control.test.mjs", "scripts/candidate-gallery-workflow.test.mjs", ".github/actions/candidate-gallery-stage/", ".github/actions/candidate-gallery/", ".github/workflows/candidate-gallery-qualification.yml", ".github/workflows/published-gallery-control.yml"], "run": ["check:candidate-gallery"]},
      {"match": ["scripts/gallery-editor-wasm.mjs", "scripts/gallery-editor-wasm.test.mjs", "scripts/build-registry-gallery-editor.mjs", "scripts/prepare-gallery-editor.mjs"], "run": ["check:gallery-editor-wasm"]},
      {"match": ["scripts/archive-tar.mjs", "scripts/link-ecosystem.mjs"], "run": ["check:archive-tar"]},
      {"match": ["spec/schemas/"], "run": ["check:spec", "check:schema-examples", "check:schema-docs", "check:core-golden", "check:registry-golden", "check:examples", "check:examples-convert", "check:text"]},
      {"match": ["scripts/generate-example-suite.mjs", "scripts/check-generated-examples.mjs", "scripts/gallery-artwork.mjs", "scripts/generate-technical-example-assets.mjs"], "run": ["check:examples", "check:examples-convert"]},
      {"match": ["spec/"], "run": ["check:spec"]},
      {"match": ["examples/"], "run": ["check:examples", "check:examples-convert", "check:text"]},
      {"match": [".github/workflows/ecosystem-ci.yml", "scripts/ci-test-shards.mjs", "scripts/ci-test-weights.json", "scripts/package-ecosystem-plan.mjs", "scripts/test-package-ecosystem.mjs", "scripts/ecosystem-scope.mjs"], "run": ["check:ci-shards", "check:ci-diet", "check:candidate-gallery"]},
      {"match": ["docs/", "README.md", "PRODUCT.md", "AGENTS.md", "skills/", "llms.txt"], "run": ["check:text"]},
      {"match": ["skills/", "docs/", "scripts/check-skill-commands.mjs", "scripts/skill-commands-allowlist.json", "packages/cli/src/"], "run": ["check:skill-commands"]},
      {"match": ["skills/", "scripts/check-skill-glossary.test.mjs"], "run": ["check:skill-glossary"]},
      {"match": ["docs/first-deck/", "scripts/check-first-deck.test.mjs", "packages/cli/src/"], "run": ["check:first-deck"]},
      {"match": ["scripts/check-examples-convert.mjs", "scripts/check-examples-convert.test.mjs", "scripts/examples-convert-worker.mjs", "packages/cli/src/"], "run": ["check:examples-convert"]},
      {"match": ["docs/examples.md", "docs/schema-reference.md", "docs/catalog-schema-reference.md"], "run": ["check:schema-docs"]},
      {"match": ["docs/programs/release-readiness/"], "run": ["check:release-report", "check:gallery-tracker"]},
      {"match": ["docs/programs/font-fidelity-everywhere/"], "run": ["check:font-tracker", "check:works-percent"]},
      {"match": ["packages/javascript/"], "run": ["check:font-hotlinks", "check:catalog-free", "check:browser-safe", "check:text"]},
      {"match": ["scripts/checks.json", "scripts/run-checks.mjs", "scripts/run-tests.mjs"], "run": ["check:runners"]},
      {"match": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "packages/javascript/package.json", "packages/cli/package.json"], "run": ["check:engines-range", "check:runners"]},
      {"match": ["scripts/agent-slot.mjs", "scripts/agent-format.mjs", "scripts/check-changed.mjs", "scripts/package-manager.mjs", "scripts/run-checks.mjs", ".claude/settings.json"], "run": ["check:agent-tools"]}
    ]
  }
}
