{
  "schema": 1,
  "description": "Which root scripts scripts/run-checks.mjs runs for `pnpm test` (RR-46). Every `check:*` script runs unless it is listed in exclude; include lists the other scripts that are part of `pnpm test`. A new check:* script needs no entry here. The excluded checks have their own CI steps. RR-57: check:changed is excluded because it runs a selection of these checks for `pnpm check:changed`; its \"changed\" section maps changed paths to the checks to run: always (every run), and rules {match: path prefixes ending in / or exact files, run: check scripts}. A check:* script whose command names a changed file also runs.",
  "include": [
    "test:gallery-base-fonts",
    "test:gallery-lazy-fonts",
    "test:gallery-script-fonts"
  ],
  "exclude": [
    "check:breaking",
    "check:changed",
    "check:examples",
    "check:quarantine"
  ],
  "changed": {
    "always": ["check:changes"],
    "rules": [
      {"match": ["scripts/published-matrix/parity-work-directory.mjs", "scripts/published-matrix/installed-parity.mjs"], "run": ["check:parity-work-directory"]},
      {"match": ["docs/programs/font-fidelity-everywhere/gallery-support/parity/build.ps1", "docs/programs/font-fidelity-everywhere/gallery-support/parity/run.ps1"], "run": ["check:parity-wrappers"]},
      {"match": ["docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/render-api.mjs", "docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/font-availability.mjs", "docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/parity.mjs"], "run": ["check:audit-render-api"]},
      {"match": ["scripts/test-registry-fidelity.mjs", "scripts/registry-fidelity-archive.mjs"], "run": ["check:registry-fidelity-archive"]},
      {"match": ["scripts/native-acceptance/"], "run": ["check:native-acceptance"]},
      {"match": ["scripts/pack-ecosystem.mjs", "scripts/ecosystem-preview-plan.mjs", "scripts/ecosystem-preview-plan.test.mjs"], "run": ["check:preview-packaging"]},
      {"match": ["scripts/gallery-editor-wasm.mjs", "scripts/gallery-editor-wasm.test.mjs", "scripts/vendor-gallery-editor.mjs", "scripts/prepare-gallery-editor.mjs"], "run": ["check:gallery-editor-wasm"]},
      {"match": ["scripts/gallery-editor-assets.mjs", "scripts/gallery-editor-assets.test.mjs", "scripts/vendor-gallery-editor.mjs", "scripts/prepare-gallery-editor.mjs"], "run": ["check:gallery-editor-assets"]},
      {"match": ["scripts/registry-consumer.mjs", "scripts/registry-consumer.test.mjs", "scripts/vendor-gallery-editor.mjs", "scripts/registry-plan.mjs", "scripts/build-gallery-snapshot.mjs", "scripts/build-gallery-snapshot.test.mjs"], "run": ["check:registry-consumer", "check:gallery-snapshot"]},
      {"match": ["scripts/archive-tar.mjs"], "run": ["check:archive-tar"]},
      {"match": ["spec/schemas/"], "run": ["check:spec", "check:schema-examples", "check:schema-docs", "check:registry-golden", "check:examples", "check:examples-convert", "check:text"]},
      {"match": ["scripts/generate-example-suite.mjs", "scripts/check-generated-examples.mjs", "scripts/gallery-artwork.mjs", "scripts/generate-technical-example-assets.mjs"], "run": ["check:examples", "check:examples-convert"]},
      {"match": ["scripts/ecosystem-lock.mjs", "scripts/ecosystem-lock.test.mjs", "scripts/ecosystem-lock.schema.json", "ecosystem.lock.json", ".github/actions/ecosystem-refs/"], "run": ["check:ecosystem-lock"]},
      {"match": ["scripts/registry-plan.mjs", "scripts/registry-plan.test.mjs", "scripts/registry-fidelity-archive.mjs", "scripts/registry-golden.mjs", "scripts/registry-toolchain.mjs", "scripts/rebuilt-release-files.mjs", "scripts/test-installed-code.mjs", "scripts/published-matrix/prepare-consumer.mjs", "scripts/published-matrix/installed-parity.mjs"], "run": ["check:registry-plan", "check:published-matrix-consumer", "check:registry-fidelity-archive", "check:registry-golden", "check:registry-toolchain", "check:rebuilt-release-files"]},
      {"match": ["scripts/prerelease-tree.test.mjs", "scripts/version-shapes.mjs", "scripts/lazy-font-counts.mjs", "scripts/lazy-font-counts.test.mjs", "scripts/check-pins.mjs", "scripts/release.mjs", "scripts/check-versions.mjs", "packages/javascript/src/node/peers.ts"], "run": ["check:prerelease"]},
      {"match": ["scripts/release.mjs", "scripts/release.test.mjs", "scripts/release-registry.mjs", "scripts/release-notes.mjs", "scripts/stamp-githead.mjs", "scripts/changelog-fragments.mjs", "scripts/gallery-stability.mjs", "scripts/check-versions.mjs", "scripts/workspace-pack.mjs"], "run": ["check:release"]},
      {"match": [".github/workflows/release.yml", ".github/workflows/npm-publish.yml", "scripts/release-workflows.test.mjs", "scripts/release.mjs"], "run": ["check:ci-workflows", "check:release"]},
      {"match": [".github/workflows/bump-sites.yml", "docs/programs/monorepo/site-workflows/", "scripts/bump-site.mjs", "scripts/bump-sites.test.mjs"], "run": ["check:ci-workflows"]},
      {"match": [".github/workflows/ci.yml", ".github/workflows/nightly.yml", ".github/workflows/slow-checks.yml", ".github/actions/setup-workspace/", "scripts/ci-scope.mjs", "scripts/ci-verify.mjs", "scripts/ci-report-issue.mjs"], "run": ["check:ci-workflows", "check:ci-scope", "check:playwright-pin"]},
      {"match": ["spec/"], "run": ["check:spec"]},
      {"match": ["examples/"], "run": ["check:examples", "check:examples-convert", "check:text"]},
      {"match": ["scripts/ci-test-shards.mjs", "scripts/ci-test-weights.json"], "run": ["check:ci-shards"]},
      {"match": ["docs/", "README.md", "PRODUCT.md", "AGENTS.md", "skills/", "llms.txt"], "run": ["check:text"]},
      {"match": ["skills/", "docs/", "scripts/check-skill-commands.mjs", "scripts/skill-commands-allowlist.json", "packages/cli/src/"], "run": ["check:skill-commands"]},
      {"match": ["skills/", "scripts/check-skill-glossary.test.mjs"], "run": ["check:skill-glossary"]},
      {"match": ["docs/first-deck/", "scripts/check-first-deck.test.mjs", "packages/cli/src/"], "run": ["check:first-deck"]},
      {"match": ["scripts/check-examples-convert.mjs", "scripts/check-examples-convert.test.mjs", "scripts/examples-convert-worker.mjs", "packages/cli/src/"], "run": ["check:examples-convert"]},
      {"match": ["docs/examples.md", "docs/schema-reference.md", "docs/catalog-schema-reference.md"], "run": ["check:schema-docs"]},
      {"match": ["docs/programs/release-readiness/"], "run": ["check:release-report", "check:gallery-tracker"]},
      {"match": ["docs/programs/font-fidelity-everywhere/"], "run": ["check:font-tracker", "check:works-percent"]},
      {"match": ["packages/javascript/"], "run": ["check:font-hotlinks", "check:catalog-free", "check:browser-safe", "check:text"]},
      {"match": ["packages/render/", "packages/pptx/", "packages/editor/", "packages/gallery/"], "run": ["check:font-hotlinks", "check:text"]},
      {"match": ["packages/gallery/catalog/", "packages/gallery/previews/"], "run": ["check:catalog", "check:catalog-free", "check:spec", "check:schema-examples", "check:stability"]},
      {"match": ["scripts/gallery-stability.mjs", "scripts/gallery-stability-fixtures.mjs", "scripts/gallery-stability.test.mjs", "scripts/changelog-fragments.mjs", "changes/", "packages/gallery/src/", "packages/gallery/package.json"], "run": ["check:stability"]},
      {"match": ["scripts/checks.json", "scripts/run-checks.mjs", "scripts/run-tests.mjs"], "run": ["check:runners"]},
      {"match": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "packages/javascript/package.json", "packages/cli/package.json", "packages/render/package.json", "packages/pptx/package.json", "packages/editor/package.json", "packages/gallery/package.json"], "run": ["check:engines-range", "check:runners"]},
      {"match": ["scripts/golden-update.mjs", "scripts/golden-update.test.mjs", ".github/workflows/golden.yml"], "run": ["check:golden-update"]},
      {"match": ["scripts/registry-golden.mjs", "scripts/registry-golden.test.mjs", "examples/", "packages/render/scripts/example-baseline.mjs", "packages/render/test/golden/"], "run": ["check:registry-golden"]},
      {"match": ["scripts/monorepo-import.mjs", "scripts/verify-import.mjs", "scripts/monorepo-import.test.mjs"], "run": ["check:monorepo-import"]},
      {"match": ["scripts/agent-worktree.mjs", "scripts/package-manager.mjs"], "run": ["check:agent-worktree"]},
      {"match": ["scripts/agent-slot.mjs", "scripts/agent-format.mjs", "scripts/check-changed.mjs", "scripts/package-manager.mjs", "scripts/run-checks.mjs", ".claude/settings.json"], "run": ["check:agent-tools"]}
    ]
  }
}
