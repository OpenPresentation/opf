{
 "$schema": "https://openpresentation.org/schema/opf/v1",
 "name": "rtl-table-numbers",
 "language": {
  "bcp47": "ar-SA",
  "fontScheme": "noto-sans-arabic"
 },
 "design": {
  "theme": "minimal",
  "footer": {
   "center": {
    "text": "{{slide.number}} / {{deck.slideCount}}"
   }
  }
 },
 "slides": [
