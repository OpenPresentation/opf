      "format": "#,##0.00"
     },
     {
      "name": "النسبة",
      "format": "#,##0"
     }
    ],
    "rows": [
     [
      "أ",
      1234.5,
      98765
     ],
     [
      "ب",
      2500.75,
      1234567
     ]
    ]
   }
  }
 ]
}