{
  "name": "@openpresentation/opf",
  "version": "0.16.0",
  "description": "Canonical Open Presentation Format schemas, TypeScript types, local validation and composition; the pinned default catalog ships as the opt-in @openpresentation/opf/catalog.",
  "license": "MIT",
  "author": "Open Presentation",
  "homepage": "https://openpresentation.org",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPresentation/opf.git",
    "directory": "packages/javascript"
  },
  "bugs": {
    "url": "https://github.com/OpenPresentation/opf/issues"
  },
  "keywords": [
    "opf",
    "open-presentation-format",
    "presentation",
    "schema",
    "json-schema",
    "catalogs",
    "slides"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./validator": {
      "types": "./dist/validator.d.ts",
      "import": "./dist/validator.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./spec-files": {
      "types": "./dist/spec-files.d.ts",
      "import": "./dist/spec-files.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./repo-readme": {
      "types": "./dist/repo-readme.d.ts",
      "import": "./dist/repo-readme.js"
    },
    "./spec/*": "./dist/spec/*",
    "./package.json": "./package.json",
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "import": "./dist/pagination.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./font-policy": {
      "types": "./dist/font-policy.d.ts",
      "import": "./dist/font-policy.js"
    },
    "./symbol-font-encodings": {
      "types": "./dist/symbol-font-encodings.d.ts",
      "import": "./dist/symbol-font-encodings.js"
    },
    "./deck": {
      "types": "./dist/deck.d.ts",
      "import": "./dist/deck.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "import": "./dist/yaml.js"
    },
    "./patch": {
      "types": "./dist/patch.d.ts",
      "import": "./dist/patch.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./convert": {
      "types": "./dist/convert.d.ts",
      "import": "./dist/convert.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./node/engine": {
      "types": "./dist/node-engine.d.ts",
      "import": "./dist/node-engine.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf dist src/generated",
    "generate": "node scripts/generate.mjs && node scripts/generate-previews.mjs && node scripts/generate-content.mjs",
    "build": "node ../../scripts/reuse-build.mjs check || (pnpm run generate && tsup && node scripts/copy-spec.mjs && node ../../scripts/reuse-build.mjs stamp)",
    "typecheck": "pnpm run generate && node ../../scripts/typecheck.mjs --noEmit",
    "test": "pnpm run build && node ../../scripts/run-tests.mjs",
    "test:packed": "node test/packed-install-smoke.mjs",
    "pack:dry-run": "pnpm run build && npm pack --dry-run --cache /tmp/opf-npm-cache"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "3.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo-google-fonts/caladea": "0.4.2",
    "@expo-google-fonts/cousine": "0.4.3",
    "@expo-google-fonts/gelasio": "0.4.1",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/roboto": "0.4.3",
    "@expo-google-fonts/roboto-mono": "0.4.2",
    "@expo-google-fonts/tinos": "0.4.2",
    "@openpresentation/opf-pptx": "0.16.0",
    "@openpresentation/opf-render": "0.16.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.13.4",
    "json-schema-to-typescript": "^16.0.0",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@openpresentation/opf-pptx": "^0.16.0",
    "@openpresentation/opf-render": "^0.16.0"
  },
  "peerDependenciesMeta": {
    "@openpresentation/opf-pptx": {
      "optional": true
    },
    "@openpresentation/opf-render": {
      "optional": true
    }
  }
}
