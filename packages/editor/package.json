  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/check-syntax.mjs src test scripts examples",
    "test": "npm run build && npm run check:font-hotlinks && node scripts/run-tests.mjs && npm run check:runners && npm run check:changes",
    "test:contract": "npm run build && node scripts/run-tests.mjs --suite contract",
    "check:runners": "node --test scripts/run-tests.test.mjs",
    "check:changes": "node --test scripts/changelog-fragments.test.mjs && node scripts/changelog-fragments.mjs check",
    "validate": "node scripts/validate-package.mjs",
    "test:packed": "node test/packed-install.mjs",
    "prepack": "npm run build",
    "check:font-hotlinks": "node --test scripts/check-font-hotlinks.test.mjs && node scripts/check-font-hotlinks.mjs",
    "check:font-hotlinks:built": "node scripts/check-font-hotlinks.mjs --built dist artifacts/playground",
    "build:playground": "node scripts/build-playground.mjs",
    "test:playground": "npm run build:playground && npm run check:font-hotlinks:built && node test/playground-pptx.mjs && node test/playground-script-fonts.mjs artifacts/playground-script-fonts && node test/playground-lazy-fonts.mjs artifacts/playground-lazy-fonts && node test/playground-base-fonts.mjs artifacts/playground-base-fonts && node test/playground-source.mjs && node test/design-controls-browser.mjs && node test/design-gaps-browser.mjs && node test/chart-options-browser.mjs && node test/persistence-browser.mjs && node test/slides-browser.mjs && node test/template-panel-browser.mjs && node test/numbering-panel-browser.mjs && node test/playground-ensure-fonts.mjs artifacts/playground-ensure-fonts && node test/canvas-fonts-browser.mjs artifacts/canvas-fonts && node test/find-replace-browser.mjs && node test/image-crop-browser.mjs && node test/mobile-browser.mjs && node test/review-panel-browser.mjs && node test/playground-download.mjs artifacts/playground-download",
    "test:code-browser": "node test/code-browser.mjs",
    "test:selection-browser": "node test/selection-browser.mjs",
    "test:click-entry-browser": "node test/click-entry-browser.mjs",
    "test:metric-browser": "node test/metric-browser.mjs",
    "test:rich-input-browser": "node test/rich-input-browser.mjs",
    "test:json": "npm run build && node test/json-source.mjs && node test/json-options.mjs",
    "test:json-browser": "node test/json-editor-browser.mjs",
    "test:design-controls-browser": "node test/design-controls-browser.mjs",
    "test:template-panel-browser": "node test/template-panel-browser.mjs",
    "test:design-gaps-browser": "node test/design-gaps-browser.mjs",
    "test:data-grid-browser": "node test/data-grid-browser.mjs",
    "test:data-grid-datasets-browser": "node test/data-grid-datasets-browser.mjs",
    "test:data-import-dataset-browser": "node test/data-import-dataset-browser.mjs",
    "test:slides-browser": "node test/slides-browser.mjs",
    "test:persistence-browser": "node test/persistence-browser.mjs",
    "test:find-browser": "node test/find-replace-browser.mjs",
    "test:crop-browser": "node test/image-crop-browser.mjs",
    "test:mobile-browser": "node test/mobile-browser.mjs",
    "test:review-panel-browser": "node test/review-panel-browser.mjs",
    "test:chart-options-browser": "node test/chart-options-browser.mjs",
