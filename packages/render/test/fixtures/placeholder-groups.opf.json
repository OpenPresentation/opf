{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Placeholder groups",
  "description": "FA-26 cross-engine fixture: layout records with nested placeholder groups, and design.chartPrimary as the group it stands for. Self-contained (no host catalog); preview, editor and PPTX must place every leaf in the same box.",
  "language": "en",
  "catalogs": {
    "default": false,
    "custom": {
      "layouts": {
        "stacked-text-chart-right": {
          "name": "Stacked text, chart right",
          "placeholders": [
            {
              "type": "title"
            },
            {
              "type": "group",
              "composition": {
                "mode": "column",
                "weights": [
                  1,
                  1
                ]
              },
              "placeholders": [
                {
                  "type": "text"
                },
                {
                  "type": "text"
                }
              ]
            },
            {
              "type": "chart"
            }
          ],
          "composition": {
            "mode": "row",
            "weights": [
              2,
              3
            ]
          }
        },
        "chart-left-stacked": {
          "name": "Chart left, two stacked",
          "summary": "A primary chart beside two stacked charts: chartPrimary left, written as a group.",
          "placeholders": [
            {
              "type": "title"
            },
            {
              "type": "chart"
            },
            {
              "type": "group",
              "composition": {
                "mode": "column"
              },
              "placeholders": [
                {
                  "type": "chart"
                },
                {
                  "type": "chart"
                }
              ]
            }
          ],
          "composition": {
            "mode": "row",
            "weights": [
              3,
              2
            ]
          }
        },
        "three-level": {
          "name": "Three levels",
          "summary": "A canvas: a top band of three columns, the middle one split twice, over a bottom band of two cells.",
          "placeholders": [
            {
              "type": "title"
            },
            {
              "type": "group",
              "composition": {
                "mode": "row",
                "weights": [
                  1,
                  2,
                  1
                ]
              },
              "placeholders": [
                {
                  "type": "text"
                },
                {
                  "type": "group",
                  "composition": {
                    "mode": "column"
                  },
                  "placeholders": [
                    {
                      "type": "text"
                    },
                    {
                      "type": "group",
                      "composition": {
                        "mode": "row"
                      },
                      "placeholders": [
                        {
                          "type": "metric"
                        },
                        {
                          "type": "metric"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "text"
                }
              ]
            },
            {
              "type": "group",
              "composition": {
                "mode": "row"
              },
              "placeholders": [
                {
                  "type": "text"
                },
                {
                  "type": "text"
                }
              ]
            }
          ],
          "composition": {
            "mode": "column",
            "weights": [
              3,
              1
            ]
          }
        }
      }
    }
  },
  "slides": [
