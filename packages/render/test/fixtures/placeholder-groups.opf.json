          "type": "text",
          "text": "Enterprise seats up 31%"
        },
        {
          "type": "text",
          "text": "Churn down to 2.1%"
        },
        {
          "type": "chart",
          "chart": {
            "type": "column",
            "alt": "Revenue by quarter",
