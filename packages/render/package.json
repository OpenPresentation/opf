{
  "name": "@openpresentation/opf-render",
  "version": "0.12.0",
  "description": "Deterministic local OPF renderer for SVG, PNG, and PDF output.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPresentation/opf-render.git"
  },
  "bugs": {
    "url": "https://github.com/OpenPresentation/opf-render/issues"
  },
  "homepage": "https://github.com/OpenPresentation/opf-render#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/svg.d.ts",
        "default": "./dist/svg.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./fonts-node": {
      "types": "./dist/fonts-node.d.ts",
      "default": "./dist/fonts-node.js"
    },
    "./fonts-browser": {
      "types": "./dist/fonts-browser.d.ts",
      "default": "./dist/fonts-browser.js"
    },
    "./export-browser": {
      "types": "./dist/export-browser.d.ts",
      "default": "./dist/export-browser.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "default": "./dist/player.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "default": "./dist/element-define.js"
    },
    "./preview-fonts": {
      "types": "./dist/preview-fonts.d.ts",
      "default": "./dist/preview-fonts.js"
    },
    "./preview-fonts-node": {
      "types": "./dist/preview-fonts-node.d.ts",
      "default": "./dist/preview-fonts-node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/check-syntax.mjs src test scripts",
    "validate": "node scripts/validate-package.mjs",
    "test": "npm run build && npm run check:fonts && node scripts/run-tests.mjs && npm run build:browser-check && npm run check:runners && npm run check:changes",
    "test:contract": "npm run build && npm run check:fonts && node scripts/run-tests.mjs --suite contract && npm run build:browser-check",
    "check:runners": "node --test scripts/run-tests.test.mjs",
    "check:changes": "node --test scripts/changelog-fragments.test.mjs && node scripts/changelog-fragments.mjs check",
    "check:fonts": "node test/font-licenses.mjs && npm run check:font-hotlinks",
    "check:font-hotlinks": "node --test scripts/check-font-hotlinks.test.mjs && node scripts/check-font-hotlinks.mjs",
    "test:golden": "npm run build && node test/golden.mjs",
    "test:packed": "node test/packed-install.mjs",
    "test:browser": "npm run build:browser-check && node test/browser-check.mjs && node test/rich-tab-browser.mjs && node test/rich-tab-estimated-browser.mjs",
    "golden:update": "npm run build && node test/golden.mjs --update",
    "golden:promote": "node scripts/golden-promote.mjs",
    "prepack": "npm run build",
    "build:browser-check": "node scripts/build-browser-check.mjs",
    "test:styled-table": "node test/styled-table.mjs",
    "test:pdf-vector": "node test/pdf-vector.mjs && node test/pdf-vector-visual.mjs",
    "test:export-browser": "node test/export-browser.mjs artifacts/export-browser",
    "report:pdf-vector": "node test/pdf-vector-visual.mjs --all --report artifacts/pdf-vector-visual.json",
    "test:code": "node test/shared-code.mjs",
    "test:code-browser": "node test/shared-code-browser.mjs",
    "test:metric": "node test/shared-metric.mjs",
    "test:images-browser": "node test/image-placeholders-browser.mjs",
    "test:font-preparation": "node test/font-preparation.mjs artifacts/font-preparation.json",
    "test:font-preparation-browser": "node test/font-preparation-browser.mjs artifacts/font-preparation-browser.json",
    "test:font-variants": "node test/font-variants.mjs",
    "test:font-variants-browser": "node test/font-variants-browser.mjs",
    "test:variable-font-gate": "node test/platform-residual-probe.mjs ../archive/test/fixtures/font-formats artifacts/variable-font-gate/live.json && node test/variable-font-retained-gate.mjs ../archive/docs/evidence/rejected-truetype-rounding-20260915 artifacts/variable-font-gate/retained.json",
    "test:aptos-preview-browser": "node test/aptos-preview-browser.mjs artifacts/aptos-preview-browser.json",
    "test:lazy-face-fallback-browser": "node test/lazy-face-fallback-browser.mjs artifacts/lazy-face-fallback",
    "test:lazy-fonts-browser": "node test/lazy-fonts-browser.mjs artifacts/lazy-fonts",
    "test:latin-family-hosts-browser": "node test/latin-family-hosts-browser.mjs artifacts/latin-family-hosts",
    "test:script-family-hosts-browser": "node test/script-family-hosts-browser.mjs artifacts/script-family-hosts",
    "test:extra-lazy-fonts-browser": "node test/extra-lazy-fonts-browser.mjs artifacts/extra-lazy-fonts",
    "test:script-fonts-browser": "node test/script-fonts-browser.mjs artifacts/script-fonts-browser.json",
    "test:script-corpora-browser": "node test/script-corpora-browser.mjs artifacts/script-corpora-browser.json && node test/script-corpora-slides-browser.mjs artifacts/script-corpora-slides-browser.json",
    "test:script-fonts-auto-browser": "node test/script-fonts-auto-browser.mjs artifacts/script-fonts-auto",
    "test:symbol-fonts-browser": "node test/symbol-fonts-browser.mjs artifacts/symbol-fonts-browser.json",
    "test:text": "node test/font-outlines.mjs && node test/accepted-text.mjs",
    "test:text-browser": "node test/accepted-text-browser.mjs",
    "test:rich-spacing-browser": "node test/rich-spacing-browser.mjs",
    "test:rich-flow-browser": "node test/rich-flow-browser.mjs",
    "test:plain-whitespace-browser": "node test/plain-whitespace-browser.mjs",
    "test:emoji-math-browser": "node test/emoji-math-browser.mjs artifacts/emoji-math-browser.json",
    "test:player": "node test/player-unit.mjs",
    "test:player-browser": "node test/player-browser.mjs artifacts/player"
  },
