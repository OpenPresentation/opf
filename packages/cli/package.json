{
  "name": "@openpresentation/cli",
  "version": "0.1.0",
  "description": "Local OPF CLI for agents: create, validate, edit, paginate, and inspect presentation JSON.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opf": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @openpresentation/opf build && tsup",
    "typecheck": "pnpm --filter @openpresentation/opf build && tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "pnpm build && node ../../scripts/run-node-tests.mjs && node test/cli.mjs",
    "test:packed": "node test/packed.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "@openpresentation/opf": "workspace:*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPresentation/opf.git",
    "directory": "packages/cli"
  }
}
