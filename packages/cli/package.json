{
  "name": "@openpresentation/cli",
  "version": "0.11.0",
  "description": "Local OPF CLI for agents: create, validate, edit, paginate, render, export to PPTX/PDF, import PPTX, and inspect presentation JSON.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opf": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @openpresentation/opf build && (node ../../scripts/reuse-build.mjs check || (tsup && node ../../scripts/reuse-build.mjs stamp))",
    "typecheck": "pnpm --filter @openpresentation/opf build && node ../../scripts/typecheck.mjs --noEmit",
    "clean": "rm -rf dist",
    "test": "pnpm build && node ../../scripts/run-tests.mjs",
    "test:packed": "node test/packed.mjs",
    "test:packed:peers": "node test/packed-files.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "@openpresentation/opf": "workspace:*",
    "@openpresentation/opf-pptx": "0.14.0",
    "@openpresentation/opf-render": "0.14.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@openpresentation/opf-pptx": "^0.14.0",
    "@openpresentation/opf-render": "^0.14.0"
  },
  "peerDependenciesMeta": {
    "@openpresentation/opf-pptx": {
      "optional": true
    },
    "@openpresentation/opf-render": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPresentation/opf.git",
    "directory": "packages/cli"
  }
}
