{
  "name": "@openpresentation/cli",
  "version": "0.16.0",
  "description": "Local OPF CLI for agents and the library API @openpresentation/cli/api: create, validate, edit, paginate, render, export to PPTX/PDF, import PPTX, and inspect presentation JSON.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opf": "./dist/index.js"
  },
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @openpresentation/opf build && (node ../../scripts/reuse-build.mjs check || (tsup && node ../../scripts/reuse-build.mjs stamp))",
    "typecheck": "pnpm --filter @openpresentation/opf build && node ../../scripts/typecheck.mjs --noEmit",
    "clean": "rm -rf dist",
    "test": "pnpm build && node ../../scripts/run-tests.mjs",
    "test:packed": "node test/packed.mjs",
    "test:packed:peers": "node test/packed-files.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@openpresentation/opf": "^0.16.0"
  },
  "devDependencies": {
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo-google-fonts/caladea": "0.4.2",
    "@expo-google-fonts/cousine": "0.4.3",
    "@expo-google-fonts/gelasio": "0.4.1",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/roboto": "0.4.3",
    "@expo-google-fonts/roboto-mono": "0.4.2",
    "@expo-google-fonts/tinos": "0.4.2",
    "@openpresentation/opf-pptx": "0.16.1",
    "@openpresentation/opf-render": "0.16.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.13.4",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@openpresentation/opf-pptx": "^0.16.0",
    "@openpresentation/opf-render": "^0.16.0"
  },
  "peerDependenciesMeta": {
    "@openpresentation/opf-pptx": {
      "optional": true
    },
    "@openpresentation/opf-render": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPresentation/opf.git",
    "directory": "packages/cli"
  }
}
