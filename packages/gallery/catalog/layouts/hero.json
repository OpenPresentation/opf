{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "hero",
  "name": "Hero",
  "summary": "A lead message with a picture and supporting points.",
  "tags": [
    "Mixed"
  ],
  "direction": "column",
  "regions": [
    {
      "name": "title"
    },
    {
      "direction": "row",
      "size": 2,
      "regions": [
        {
          "name": "lead",
          "accepts": [
            "text",
            "quote",
            "metric"
          ],
          "role": "primary",
          "flow": "none"
        },
        {
          "name": "media",
          "accepts": [
            "image",
            "video"
          ],
          "role": "media",
          "flow": "none"
        }
      ]
    },
    {
      "name": "support",
      "size": 1,
      "accepts": [
        "text",
        "list",
        "metric",
        "group"
      ],
      "role": "supporting",
      "flow": "grid"
    }
  ],
  "description": "Combine a prominent visual or message with supporting content. Use it when one element should lead the audience into the details.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/hero.svg"
  }
}
