{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "hero",
  "name": "Hero",
  "summary": "A lead message and its supporting points beside a full-height picture.",
  "tags": [
    "Mixed"
  ],
  "direction": "row",
  "regions": [
    {
      "direction": "column",
      "size": 3,
      "regions": [
        {
          "name": "title"
        },
        {
          "name": "lead",
          "size": "auto",
          "accepts": [
            "text",
            "quote",
            "metric"
          ],
          "role": "primary",
          "flow": "none"
        },
        {
          "name": "support",
          "accepts": [
            "text",
            "list",
            "metric",
            "group"
          ],
          "role": "supporting",
          "flow": "auto"
        }
      ]
    },
    {
      "name": "media",
      "size": 2,
      "accepts": [
        "image",
        "video"
      ],
      "role": "media",
      "flow": "none",
      "bleed": true
    }
  ],
  "description": "Combine a prominent visual or message with supporting content. Use it when one element should lead the audience into the details.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/hero.svg"
  }
}
