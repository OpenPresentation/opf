{
  "$schema": "https://openpresentation.org/schema/opf-layout/v1",
  "id": "dashboard",
  "name": "Dashboard",
  "summary": "Headline metrics above a row of small charts for an at-a-glance overview. Bird's-eye view of a business or function.",
  "description": "Headline metrics above a row of small charts for an at-a-glance overview. Bird's-eye view of a business or function.",
  "design": {
    "titleAlignment": "left",
    "contentAlignment": "left",
    "contentBox": true,
    "contentDirection": "horizontal"
  },
  "placeholders": [
    {
      "type": "title"
    },
    {
      "type": "group",
      "composition": {
        "mode": "row"
      },
      "placeholders": [
        {
          "type": "metric"
        },
        {
          "type": "metric"
        },
        {
          "type": "metric"
        }
      ]
    },
    {
      "type": "group",
      "composition": {
        "mode": "row"
      },
      "placeholders": [
        {
          "type": "chart"
        },
        {
          "type": "chart"
        },
        {
          "type": "chart"
        }
      ]
    }
  ],
  "tags": [
    "Overview",
    "Multi-chart",
    "Monitoring"
  ],
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/dashboard.svg"
  },
  "composition": {
    "mode": "column",
    "weights": [
      2,
      3
    ]
  }
}
