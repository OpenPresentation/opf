{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "chart",
  "name": "Chart",
  "summary": "One to six charts, with an optional note.",
  "tags": [
    "Visuals"
  ],
  "direction": "column",
  "regions": [
    {
      "name": "title"
    },
    {
      "name": "charts",
      "accepts": [
        "chart",
        "group"
      ],
      "role": "primary",
      "flow": "grid"
    },
    {
      "name": "note",
      "size": "auto",
      "accepts": [
        "text"
      ],
      "role": "supporting",
      "flow": "none"
    }
  ],
  "description": "Give a chart enough space to show its evidence. Use the title to state the conclusion and labels to explain the measures.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/chart.svg"
  }
}
