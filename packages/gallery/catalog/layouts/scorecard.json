{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "scorecard",
  "name": "Scorecard",
  "summary": "Headline measures with their targets and status.",
  "tags": [
    "Numbers"
  ],
  "design": {
    "contentBox": true
  },
  "direction": "column",
  "anchor": "middle",
  "regions": [
    {
      "name": "title"
    },
    {
      "name": "cards",
      "accepts": [
        "metric",
        "text",
        "list",
        "group"
      ],
      "role": "primary",
      "flow": "grid",
      "metrics": "tile"
    }
  ],
  "description": "Summarize performance across comparable measures. State the criteria consistently so the audience can assess the result.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/scorecard.svg"
  }
}
