{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "pillars",
  "name": "Pillars",
  "summary": "Related ideas arranged in equal columns.",
  "tags": [
    "Groups of items"
  ],
  "design": {
    "contentBox": false
  },
  "direction": "column",
  "regions": [
    {
      "name": "title"
    },
    {
      "name": "pillars",
      "accepts": [
        "text",
        "list",
        "metric",
        "image",
        "group"
      ],
      "role": "primary",
      "flow": "grid"
    }
  ],
  "description": "Show the main themes or principles behind an idea. Give each item a short heading and a comparable amount of detail.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/pillars.svg"
  }
}
