{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "faq",
  "name": "FAQ",
  "summary": "Questions with their answers.",
  "tags": [
    "Groups of items"
  ],
  "design": {
    "contentBox": false
  },
  "areas": [
    [
      "title"
    ],
    [
      "questions"
    ]
  ],
  "columns": [
    1
  ],
  "rows": [
    "auto",
    1
  ],
  "regions": {
    "questions": {
      "accepts": [
        "list",
        "text",
        "group"
      ],
      "role": "primary",
      "flow": "column",
      "listColumns": "auto"
    }
  },
  "description": "Answer the questions an audience is likely to ask. Pair each question with a direct answer and group related questions together.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/faq.svg"
  }
}
