{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "quote",
  "name": "Quote",
  "summary": "One or more quotations with attribution and photo.",
  "tags": [
    "Text"
  ],
  "direction": "column",
  "anchor": "middle",
  "regions": [
    {
      "name": "title"
    },
    {
      "name": "quotes",
      "accepts": [
        "quote",
        "group"
      ],
      "role": "primary",
      "flow": "grid"
    }
  ],
  "description": "Highlight a quotation and its source. Use the attribution to explain who said it and why their perspective matters.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/quote.svg"
  }
}
