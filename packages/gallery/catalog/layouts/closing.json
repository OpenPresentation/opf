{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "closing",
  "name": "Closing",
  "summary": "The last slide: thanks, the call to action and contact details.",
  "tags": [
    "Openers and closers"
  ],
  "design": {
    "titleAlignment": "center",
    "contentAlignment": "center"
  },
  "areas": [
    "title",
    "details"
  ],
  "columns": [
    1
  ],
  "rows": [
    1,
    "auto"
  ],
  "regions": {
    "details": {
      "accepts": [
        "text",
        "list",
        "image"
      ],
      "role": "supporting",
      "flow": "auto"
    }
  },
  "description": "End with the action the audience should take. Include contact details or a brief thank-you when useful.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/closing.svg"
  }
}
