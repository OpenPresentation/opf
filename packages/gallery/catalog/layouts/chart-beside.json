{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "chart-beside",
  "name": "Chart beside",
  "summary": "A chart with the takeaway beside it.",
  "tags": [
    "Visuals"
  ],
  "direction": "column",
  "regions": [
    {
      "name": "title"
    },
    {
      "direction": "row",
      "regions": [
        {
          "name": "chart",
          "size": 3,
          "accepts": [
            "chart"
          ],
          "role": "primary",
          "flow": "none"
        },
        {
          "name": "notes",
          "size": 2,
          "accepts": [
            "text",
            "list",
            "metric",
            "quote",
            "chart"
          ],
          "role": "supporting",
          "flow": "column"
        }
      ]
    }
  ],
  "description": "Pair a chart with an explanation of its result. Keep the text focused on the pattern or decision supported by the data.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/chart-beside.svg"
  }
}
