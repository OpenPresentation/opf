{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "image-beside",
  "name": "Image beside",
  "summary": "A picture or video beside text.",
  "tags": [
    "Visuals"
  ],
  "areas": [
    "title title",
    "media body"
  ],
  "columns": [
    1,
    1
  ],
  "rows": [
    "auto",
    1
  ],
  "regions": {
    "media": {
      "accepts": [
        "image",
        "video"
      ],
      "role": "media",
      "flow": "none"
    },
    "body": {
      "accepts": [
        "text",
        "list",
        "metric",
        "quote",
        "group"
      ],
      "role": "primary",
      "flow": "auto"
    }
  },
  "description": "Explain a visual alongside its supporting text. Use the text to direct attention to the meaningful parts of the image.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/image-beside.svg"
  },
  "design": {
    "imageFit": "contain"
  }
}
