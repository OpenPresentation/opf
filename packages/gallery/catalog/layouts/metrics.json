{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "metrics",
  "name": "Metrics",
  "summary": "One to six headline numbers, with an optional note.",
  "tags": [
    "Numbers"
  ],
  "design": {
    "contentAlignment": "center"
  },
  "direction": "column",
  "regions": [
    {
      "name": "title"
    },
    {
      "name": "metrics",
      "accepts": [
        "metric",
        "group"
      ],
      "role": "primary",
      "flow": "grid",
      "anchor": "middle"
    },
    {
      "name": "note",
      "size": "auto",
      "accepts": [
        "text",
        "list"
      ],
      "role": "supporting",
      "flow": "none"
    }
  ],
  "description": "Highlight a small set of important numbers. Give each number a label and the context needed to interpret it.",
  "preview": {
    "vectorSrc": "https://www.pptx.gallery/layout-previews/metrics.svg"
  }
}
