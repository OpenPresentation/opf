{
  "name": "@openpresentation/gallery",
  "version": "1.0.0",
  "description": "The pptx.gallery catalog for OPF: layouts, themes, colour and font schemes, narratives, audiences, purposes and tones, registered with catalogs: [gallery].",
  "license": "MIT",
  "author": "Open Presentation",
  "homepage": "https://www.pptx.gallery",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPresentation/opf.git",
    "directory": "packages/gallery"
  },
  "bugs": {
    "url": "https://github.com/OpenPresentation/opf/issues"
  },
  "keywords": [
    "opf",
    "open-presentation-format",
    "presentation",
    "catalog",
    "layouts",
    "themes",
    "pptx-gallery"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./previews": {
      "types": "./dist/previews.d.ts",
      "default": "./dist/previews.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "opf": {
    "catalogSchema": 1
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "pnpm --filter @openpresentation/opf build && node scripts/build.mjs && tsc -p test/tsconfig.json",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "check:stability": "node scripts/build.mjs && node scripts/stability.mjs",
    "pack:dry-run": "npm pack --dry-run --cache /tmp/opf-npm-cache",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@openpresentation/opf-render": "0.18.0",
    "@resvg/resvg-js": "2.6.2",
    "typescript": "~5.9.3"
  }
}
