{
  "name": "@openpresentation/gallery",
  "version": "3.0.0",
  "description": "The pptx.gallery catalog for OPF: layouts, themes, colour and font schemes, narratives, audiences, purposes and tones, registered with catalogs: [gallery].",
  "license": "MIT",
  "author": "Open Presentation",
  "homepage": "https://www.pptx.gallery",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPresentation/gallery.git"
  },
  "bugs": {
    "url": "https://github.com/OpenPresentation/gallery/issues"
  },
  "keywords": [
    "opf",
    "open-presentation-format",
    "presentation",
    "catalog",
    "layouts",
    "themes",
    "pptx-gallery"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./previews": {
      "types": "./dist/previews.d.ts",
      "default": "./dist/previews.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "opf": {
    "catalogSchema": 3
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "typecheck": "node scripts/build.mjs && tsc -p test/tsconfig.json",
    "verify": "node scripts/sync-gallery-catalog.mjs --verify",
    "rehash": "node scripts/sync-gallery-catalog.mjs --rehash --match-gallery",
    "previews": "node scripts/render-previews.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:previews": "node scripts/render-previews.mjs --check",
    "check:stability": "node scripts/build.mjs && node scripts/stability.mjs",
    "sync": "node scripts/sync-gallery-catalog.mjs --gallery ../pptx-gallery",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@openpresentation/opf": "0.19.0",
    "@openpresentation/opf-render": "0.19.1",
    "@resvg/resvg-js": "2.6.2",
    "typescript": "~5.9.3"
  }
}
