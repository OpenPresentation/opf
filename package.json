{
  "name": "openpresentation-workspace",
  "private": true,
  "description": "Workspace for OPF format packages and tooling.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openpresentation/opf build && pnpm --filter @openpresentation/cli build",
    "typecheck": "pnpm --filter @openpresentation/opf typecheck && pnpm --filter @openpresentation/cli typecheck",
    "check:text": "node --test scripts/check-text-integrity.test.mjs && node scripts/check-text-integrity.mjs",
    "check:changes": "node --test scripts/changelog-fragments.test.mjs && node scripts/changelog-fragments.mjs check",
    "check:runners": "node --test scripts/run-tests.test.mjs scripts/run-checks.test.mjs",
    "check:reuse-build": "node --test scripts/reuse-build.test.mjs",
    "test": "pnpm --filter @openpresentation/opf test && pnpm test:cli && node scripts/run-checks.mjs",
    "check:quarantine": "node --test scripts/quarantine.test.mjs && node scripts/quarantine.mjs check",
    "test:flake-repeat": "node scripts/flake-repeat.mjs",
    "check:engines-range": "node --test scripts/check-engines-range.test.mjs && node scripts/check-engines-range.mjs",
    "check:font-hotlinks": "node --test scripts/check-font-hotlinks.test.mjs && node scripts/check-font-hotlinks.mjs",
    "check:published-matrix": "node --test scripts/published-matrix/digests.test.mjs scripts/published-matrix/compare-parity.test.mjs scripts/published-matrix/installed-parity.test.mjs",
    "check:font-tracker": "node --test scripts/build-font-tracker.test.mjs scripts/qualify-latin-fonts.test.mjs && node scripts/build-font-tracker.mjs --check",
    "build:font-tracker": "node scripts/build-font-tracker.mjs",
    "check:gallery-tracker": "node --test scripts/build-gallery-tracker.test.mjs scripts/tracker-staleness.test.mjs && node scripts/build-gallery-tracker.mjs --check",
    "build:gallery-tracker": "node scripts/build-gallery-tracker.mjs",
    "report:works": "node docs/programs/font-fidelity-everywhere/gallery-support/works-percent.mjs",
    "report:release": "node docs/programs/release-readiness/report.mjs",
    "check:release-report": "node --test docs/programs/release-readiness/report.test.mjs",
    "check:registry-golden": "node --test scripts/registry-golden.test.mjs",
    "check:core-golden": "node --test scripts/core-golden.test.mjs",
    "check:release-train": "node --test scripts/release-train.test.mjs",
    "check:works-percent": "node --test docs/programs/font-fidelity-everywhere/gallery-support/works-percent.test.mjs",
    "pack:dry-run": "pnpm --filter @openpresentation/opf pack:dry-run",
    "test:ecosystem": "node --import ./scripts/register-local-opf.mjs scripts/test-ecosystem.mjs",
    "test:slide-images": "node --import ./scripts/register-local-opf.mjs scripts/test-slide-image-ecosystem.mjs",
    "test:gallery": "node --import ./scripts/register-local-opf.mjs scripts/test-gallery-snippets.mjs",
    "demo:editor": "node scripts/build-editor-demo.mjs",
    "test:pagination": "node --import ./scripts/register-local-opf.mjs scripts/test-pagination-ecosystem.mjs",
    "test:fonts": "node --import ./scripts/register-local-opf.mjs scripts/test-font-ecosystem.mjs && node --import ./scripts/register-local-opf.mjs scripts/test-office-fonts.mjs && node --import ./scripts/register-local-opf.mjs scripts/test-font-switch-ecosystem.mjs",
    "pack:ecosystem": "node scripts/pack-ecosystem.mjs",
    "test:packed-ecosystem": "node scripts/test-packed-ecosystem.mjs",
    "test:packed-browser": "node scripts/test-packed-browser.mjs",
    "test:gallery-transfer": "node scripts/test-gallery-transfer.mjs",
    "test:gallery-script-fonts": "node scripts/test-gallery-script-fonts.mjs",
    "test:gallery-base-fonts": "node scripts/test-gallery-base-fonts.mjs",
    "test:gallery-lazy-fonts": "node scripts/test-gallery-lazy-fonts.mjs",
    "prepare:gallery": "node scripts/prepare-gallery-editor.mjs",
    "build:spec-reference": "node scripts/build-spec-reference.mjs",
    "test:skills": "node scripts/test-skills.mjs",
    "test:cli": "pnpm --filter @openpresentation/cli test",
    "test:cli:packed": "pnpm --filter @openpresentation/cli test:packed",
    "test:cli:packed:peers": "pnpm --filter @openpresentation/cli test:packed:peers",
    "test:data": "node --import ./scripts/register-local-opf.mjs scripts/test-data-ecosystem.mjs",
    "test:rich-text": "node --import ./scripts/register-local-opf.mjs scripts/test-rich-text-ecosystem.mjs",
    "test:agent-site": "node scripts/test-agent-site.mjs",
    "test:layout": "node --import ./scripts/register-local-opf.mjs scripts/test-layout-ecosystem.mjs",
    "test:lists": "node --import ./scripts/register-local-opf.mjs scripts/test-list-ecosystem.mjs",
    "lint": "biome check .",
    "check:spec": "node scripts/check-spec-integrity.mjs",
    "check:schema-docs": "node scripts/generate-schema-docs.mjs --check",
    "check:catalog": "node --test scripts/sync-gallery-catalog.test.mjs && node scripts/sync-gallery-catalog.mjs --verify",
    "sync:catalog": "node scripts/sync-gallery-catalog.mjs --gallery ../pptx-gallery",
    "check:examples": "node scripts/validate-examples.mjs && node scripts/inspect-lint-examples.mjs && node scripts/check-generated-examples.mjs",
    "check:breaking": "node scripts/test-breaking-gate.mjs && node scripts/check-breaking-changes.mjs",
    "test:packages": "node scripts/test-package-ecosystem.mjs",
    "test:registry-ecosystem": "node scripts/test-packed-ecosystem.mjs --registry",
    "test:registry-libraries": "node scripts/test-packed-ecosystem.mjs --registry-libraries",
    "prepare:gallery:registry": "node scripts/prepare-gallery-editor.mjs --registry",
    "build:showcase:registry": "node scripts/build-site-showcase.mjs --registry",
    "test:registry-fidelity": "node scripts/test-registry-fidelity.mjs",
    "test:layout-contracts:registry": "node scripts/test-layout-contract-registry.mjs",
    "test:developer-quickstart": "node scripts/test-developer-quickstart.mjs",
    "check:audit-placement": "node --test docs/programs/font-fidelity-everywhere/gallery-support/audit-a/scripts/placement.test.mjs",
    "check:audit-chartex": "node --test docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/chartex.test.mjs docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/chart-text.test.mjs docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/chart-colors.test.mjs",
    "check:audit-restored": "node --test docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/restored-content.test.mjs",
    "check:audit-picture-bullets": "node --test docs/programs/font-fidelity-everywhere/gallery-support/parity/scripts/picture-bullets.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@typescript/native": "npm:typescript@~7.0.2"
  }
}
