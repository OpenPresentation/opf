              "type": "text",
              "layout": "two-column"
            },
            {
              "id": "why-now",
              "name": "Why Now",
              "description": "Explain the urgency. What changes if we wait? What window is closing?",
              "instructions": "Make the timing urgent and concrete.",
              "type": "metric",
              "layout": "metrics"
            },
            {
              "id": "why-this-way",
              "name": "Why This Way",
              "description": "Show that alternatives were considered. Build trust by demonstrating thoughtful decision-making.",
