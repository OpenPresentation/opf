{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Asset Source Forms",
  "description": "Technical fixture for string shorthand and object-form assets across images, video, logos, and chart data.",
  "language": "en-US",
  "organization": {
    "id": "brand",
    "name": "Asset Source Forms",
    "logo": {
      "full": {
        "onLight": "asset:logo",
        "onDark": "asset:logo-light"
      },
      "icon": "asset:icon"
    }
  },
  "design": {
    "watermark": {
      "src": "asset:watermark",
      "opacity": 0.08
    },
    "imageFit": "contain"
  },
  "assets": {
    "logo": {
      "src": "./assets/logo.svg",
      "alt": "Asset Source Forms logo",
      "mediaType": "image/svg+xml"
    },
    "logo-light": {
      "src": "./assets/logo-light.svg",
      "alt": "Light logo",
      "mediaType": "image/svg+xml"
    },
    "icon": {
      "src": "./assets/icon.svg",
      "alt": "Icon mark",
      "mediaType": "image/svg+xml"
    },
    "watermark": "./assets/watermark.png",
    "cover-photo": {
      "src": "./assets/cover.png",
      "alt": "Cover photo",
      "mediaType": "image/png"
    },
    "remote-image": "https://cdn.example.com/image.png",
    "data-uri-image": "data:image/svg+xml;base64,",
    "demo-video": {
      "src": "./media/demo.mp4",
      "mediaType": "video/mp4",
      "title": "Demo"
    },
    "pipeline-data": {
      "src": "./data/pipeline.csv",
      "mediaType": "text/csv"
    }
  },
  "slides": [
    {
      "title": "Asset Reference Image",
      "type": "image",
      "image": {
        "src": "asset:remote-image",
        "alt": "Remote picture referenced by URL"
      }
    },
    {
      "title": "Data URI Image",
      "type": "image",
      "image": {
        "src": "asset:data-uri-image",
        "alt": "Small inline image"
      }
    },
    {
      "title": "Asset Reference Video",
      "type": "video",
      "video": {
        "src": "asset:demo-video",
        "alt": "Demo walkthrough video"
      }
    },
    {
      "title": "Pipeline Chart",
      "chart": {
        "type": "bar",
        "data": {
          "columns": [
            "Stage",
            "Count"
          ],
          "rows": [
            [
              "Lead",
              120
            ],
            [
              "Qualified",
              64
            ],
            [
              "Proposal",
              31
            ],
            [
              "Won",
              12
            ]
          ]
        }
      }
    }
  ]
}
