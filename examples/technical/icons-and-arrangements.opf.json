{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Icons, arrangements and connectors",
  "description": "Technical example for the 0.33 drawing features on one fictional product-launch story: icons from the gallery's Lucide and Tabler sets (icon cards, a list with icon chips, metric icons), the pyramid, matrix, cycle, chevrons, flow and vertical-flow layouts (live SmartArt in PowerPoint where it holds the text, native shapes elsewhere), and a slide of shapes joined by connectors. The icon sets load on demand; the CLI and the MCP register them (see docs/icons.md, docs/smartart.md and docs/shapes.md).",
  "language": "en-US",
  "design": {
    "background": "light1"
  },
  "slides": [
    {
      "id": "icon-cards",
      "title": "What is new in the launch",
      "items": [
        {
          "text": "Offline mode",
          "description": "Keep working without a connection.",
          "icon": "lucide:wifi-off"
        },
        {
          "text": "Shared workspaces",
          "description": "One place for a team's files.",
          "icon": "lucide:users"
        },
        {
          "text": "Faster exports",
          "description": "Decks leave as PDF in seconds.",
          "icon": "tabler:rocket"
        },
        {
          "text": "Safer sharing",
          "description": "Links expire and can be revoked.",
          "icon": "lucide:shield-check"
        }
      ]
    },
    {
      "id": "icon-list",
      "title": "Why customers switch",
      "items": [
        {
          "text": "Setup takes an afternoon, not a quarter.",
          "icon": "lucide:clock"
        },
        {
          "text": "Every plan includes the admin console.",
          "icon": "lucide:shield-check"
        },
        {
          "text": "Support answers within one business day.",
          "icon": "lucide:users"
        }
      ]
    },
    {
      "id": "metric-icons",
      "title": "Launch results at a glance",
      "blocks": [
        {
          "metric": {
            "value": "52",
            "label": "Pilot teams",
            "icon": "lucide:users"
          }
        },
        {
          "metric": {
            "value": "84%",
            "label": "Task completion",
            "icon": "lucide:chart-bar"
          }
        },
        {
          "metric": {
            "value": "6.2",
            "label": "Median task time",
            "unit": "min",
            "icon": "lucide:clock"
          }
        }
      ]
    },
    {
      "id": "pyramid",
      "layout": "pyramid",
      "title": "Our strategy",
      "items": [
        "Vision",
        "Goals",
        "Programs",
        "Teams"
      ]
    },
    {
      "id": "matrix",
      "layout": "matrix",
      "title": "Four markets",
      "items": [
        "Enterprise",
        "Mid-market",
        "Consumer",
        "Public sector"
      ]
    },
    {
      "id": "cycle",
      "layout": "cycle",
      "title": "How each round feeds the next",
      "items": [
        "Plan",
        "Pilot",
        "Measure",
        "Adjust"
      ]
    },
    {
      "id": "chevrons",
      "layout": "chevrons",
      "title": "How we work",
      "items": [
        "Plan",
        "Build",
        "Test",
        "Ship"
      ]
    },
    {
      "id": "flow",
      "layout": "flow",
      "title": "From request to release",
      "items": [
        "Request",
        "Review",
        "Build",
        "Release"
      ]
    },
    {
      "id": "vertical-flow",
      "layout": "vertical-flow",
      "title": "What happens after sign-up",
      "items": [
        "Create the workspace",
        "Invite the team",
        "Import the first deck",
        "Share it"
      ]
    },
    {
      "id": "connectors",
      "title": "Shapes joined by connectors",
      "blocks": [
        {
          "id": "plan",
          "text": "Plan",
          "aspectRatio": 1.6,
          "shape": "roundRect"
        },
        {
          "id": "build",
          "text": "Build",
          "aspectRatio": 1.6,
          "shape": "roundRect"
        },
        {
          "id": "ship",
          "text": "Ship",
          "aspectRatio": 1,
          "shape": "ellipse"
        }
      ],
      "shapes": [
        {
          "connector": {
            "from": "plan",
            "to": "build",
            "route": "straight"
          },
          "stroke": {
            "width": 3,
            "end": {
              "type": "triangle"
            }
          }
        },
        {
          "connector": {
            "from": "build",
            "to": "ship",
            "route": "straight"
          },
          "stroke": {
            "color": "accent1",
            "width": 3,
            "end": {
              "type": "stealth",
              "length": "large"
            }
          }
        }
      ]
    }
  ],
  "catalogs": {
    "default": {
      "source": "https://www.pptx.gallery",
      "layouts": {
        "pyramid": {
          "name": "Pyramid",
          "summary": "Levels that build on each other, as a pyramid, the first at the top.",
          "tags": [
            "Groups of items"
          ],
          "direction": "column",
          "regions": [
            {
              "name": "title"
            },
            {
              "name": "levels",
              "accepts": [
                "list"
              ],
              "role": "primary",
              "flow": "none",
              "arrangement": "pyramid"
            }
          ],
          "description": "Show a hierarchy of 1 to 8 levels, from the narrow top (the peak, the few, the goal) to the broad base (the foundation, the many). Write one short list entry per level, the top level first.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/pyramid.svg"
          }
        },
        "matrix": {
          "name": "Matrix",
          "summary": "Four parts of a whole, as the quadrants of a square beside the title.",
          "tags": [
            "Groups of items"
          ],
          "direction": "row",
          "regions": [
            {
              "name": "title",
              "size": 2
            },
            {
              "name": "quadrants",
              "accepts": [
                "list"
              ],
              "role": "primary",
              "flow": "none",
              "arrangement": "matrix",
              "size": 3
            }
          ],
          "description": "Show four parts that together make a whole, or the four cases of two choices, as a 2 x 2 matrix. Write four short list entries, in the order top left, top right, bottom left, bottom right; another count is drawn as a grid of cards.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/matrix.svg"
          }
        },
        "cycle": {
          "name": "Cycle",
          "summary": "Steps that repeat, as a loop of nodes with arrows beside the title.",
          "tags": [
            "Groups of items"
          ],
          "direction": "row",
          "regions": [
            {
              "name": "title",
              "size": 2
            },
            {
              "name": "stages",
              "accepts": [
                "list"
              ],
              "role": "primary",
              "flow": "none",
              "arrangement": "cycle",
              "size": 3
            }
          ],
          "description": "Show 2 to 8 steps that repeat, where the last leads back to the first (a review loop, a product lifecycle, a feedback cycle). Write one short list entry per step, in order; the first is drawn at the top and the rest clockwise, with an arrow from each to the next.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/cycle.svg"
          }
        },
        "chevrons": {
          "name": "Chevrons",
          "summary": "Stages in order, as a row of chevrons.",
          "tags": [
            "Groups of items"
          ],
          "direction": "column",
          "regions": [
            {
              "name": "title"
            },
            {
              "name": "stages",
              "accepts": [
                "list"
              ],
              "role": "primary",
              "flow": "none",
              "arrangement": "chevrons"
            }
          ],
          "description": "Show 1 to 8 stages that follow one another, each leading into the next. Write one short list entry per stage, in order; a word or two reads best inside a chevron.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/chevrons.svg"
          }
        },
        "flow": {
          "name": "Flow",
          "summary": "Steps in order, as boxes joined by arrows in one row.",
          "tags": [
            "Groups of items"
          ],
          "direction": "column",
          "regions": [
            {
              "name": "title"
            },
            {
              "name": "stages",
              "accepts": [
                "list"
              ],
              "role": "primary",
              "flow": "none",
              "arrangement": "flow"
            }
          ],
          "description": "Show 1 to 8 steps that follow one another, each a box with an arrow to the next. Write one short list entry per step, in order.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/flow.svg"
          }
        },
        "vertical-flow": {
          "name": "Vertical flow",
          "summary": "Steps in order, as boxes joined by arrows in a column beside the title.",
          "tags": [
            "Groups of items"
          ],
          "direction": "row",
          "regions": [
            {
              "name": "title",
              "size": 2
            },
            {
              "name": "stages",
              "accepts": [
                "list"
              ],
              "role": "primary",
              "flow": "none",
              "arrangement": "vertical-flow",
              "size": 3
            }
          ],
          "description": "Show 1 to 8 steps that follow one another from top to bottom, each a box with an arrow to the next, beside the title. Write one short list entry per step, in order.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/vertical-flow.svg"
          }
        }
      },
