{
  "name": "Bilingual event",
  "description": "One deck in two languages. A variable carries translations, and the language where it is drawn (the slide's declared language, else the deck's) selects one: German on the German slides, French on the French ones. A date's translation is its pattern, so the same date is written in each language.",
  "language": "de",
  "variables": {
    "event": {
      "type": "text",
      "label": "Event name",
      "value": "Product day",
      "translations": {
        "de": {
          "value": "Produkttag"
        },
        "fr": {
          "value": [
            {
              "text": "Journée "
            },
            {
              "text": "produit",
              "bold": true
            }
          ]
        }
      }
    },
    "event-date": {
      "type": "date",
      "label": "Event date",
      "value": "2026-03-05",
      "translations": {
        "de": {
          "format": "EEEE, d. MMMM yyyy"
        },
        "fr": {
          "format": "EEEE d MMMM yyyy"
        }
      }
    },
    "cta": {
      "type": "text",
      "label": "Call to action",
      "value": "Book a demo",
      "translations": {
        "de": {
          "value": "Demo buchen"
        },
        "fr": {
          "value": "Réserver une démo"
        }
      }
    },
    "signup": {
      "type": "url",
      "label": "Sign-up page",
      "value": "https://example.com/en/demo",
      "translations": {
        "de": {
          "value": "https://example.com/de/demo"
        },
        "fr": {
          "value": "https://example.com/fr/demo"
        }
      }
    },
    "badge": {
      "type": "image",
      "label": "Event badge",
      "value": {
        "src": "data:image/svg+xml;base64,",
        "alt": "Product day"
      },
      "translations": {
        "de": {
          "value": {
            "src": "data:image/svg+xml;base64,",
            "alt": "Produkttag"
          }
        },
        "fr": {
          "value": {
            "src": "data:image/svg+xml;base64,",
            "alt": "Journée produit"
          }
        }
      }
    },
    "agenda": {
      "type": "list",
      "label": "Agenda",
      "value": [
        "Welcome",
        "Roadmap",
        "Customer stories"
      ],
      "translations": {
        "de": {
          "value": [
            "Begrüßung",
            "Roadmap",
            "Kundengeschichten"
          ]
        },
        "fr": {
          "value": [
            "Accueil",
            "Feuille de route",
            "Témoignages clients"
          ]
        }
      }
    }
  },
  "slides": [
    {
      "id": "cover-de",
      "title": "{{event}}",
      "subtitle": "{{event-date}} in Berlin",
      "text": [
        {
          "text": "{{cta}}",
          "bold": true,
          "link": "var:signup"
        }
      ]
    },
    {
      "id": "agenda-de",
      "title": "Programm",
      "items": [
        "var:agenda"
      ],
      "image": "var:badge"
    },
    {
      "id": "cover-fr",
      "language": "fr",
      "title": "{{event}}",
      "subtitle": "{{event-date}} à Paris",
      "text": [
        {
          "text": "{{cta}}",
          "bold": true,
          "link": "var:signup"
        }
      ]
    },
    {
      "id": "agenda-fr",
      "language": "fr",
      "title": "Programme",
      "items": [
        "var:agenda"
      ],
      "image": "var:badge"
    }
  ]
}
