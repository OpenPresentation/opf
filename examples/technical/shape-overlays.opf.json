          "stroke": {
            "width": 2,
            "color": "accent2",
            "start": {
              "type": "oval",
              "width": "small",
              "length": "small"
            },
            "end": {
              "type": "arrow"
            }
          },
          "alt": "Review sends the work back to planning"
        }
      ],
      "composition": {
        "gap": 0.1
      }
    },
