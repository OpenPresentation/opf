{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Shape overlays",
  "description": "Technical fixture for overlay shapes and connectors (SH-04): callouts and badges placed by fractions of the slide, shapes attached to blocks with at (a picture included), straight, elbow and curved connectors between blocks and overlay shapes with arrowheads, every route between facing, same-facing and perpendicular sites, an authored connector adjust, and the back layer. shape-overlays-rtl.opf.json is the right-to-left slide.",
  "language": "en-US",
  "slides": [
    {
      "title": "Callouts and badges",
      "blocks": [
        {
          "id": "revenue",
          "metric": {
            "value": "$4.2M",
            "label": "Quarterly revenue"
          }
        },
        {
          "id": "summary",
          "text": "Revenue grew in every region this quarter, led by the new self-serve plan."
        }
      ],
      "shapes": [
        {
          "id": "record",
          "shape": "wedgeRectCallout",
          "text": "Record quarter",
          "x": 0.06,
          "y": 0.26,
          "width": 0.2,
          "height": 0.1,
          "style": "subtle",
          "adjust": {
            "adj1": 0.35,
            "adj2": 0.9
          }
        },
        {
          "id": "new",
          "shape": "star12",
          "text": "New",
          "x": 0.86,
          "y": 0.05,
          "width": 0.1,
          "height": 0.16,
          "fill": "accent2",
          "stroke": "none"
