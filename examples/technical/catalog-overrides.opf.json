{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Catalog Overrides",
  "description": "Technical fixture for catalog groups: the document defines its own theme, schemes, audience, purpose and tone in catalogs.custom, and takes its narrative from a named catalog group (example:fixture-proof).",
  "audience": [
    {
      "id": "technical-reviewers",
      "name": "Technical Reviewers",
      "technicalFluency": "high",
      "decisionPower": "advisory"
    }
  ],
  "purpose": {
    "id": "technical-approval",
    "name": "Technical Approval",
    "outcome": "Approve the fixture contract"
  },
  "tone": {
    "id": "precise-plain",
    "name": "Precise Plain",
    "voiceCues": [
      "Name the object shape before the rationale.",
      "Prefer short exact claims."
    ]
  },
  "narrative": "example:fixture-proof",
  "design": {
    "theme": "fixture-theme",
    "background": "light1",
    "colorScheme": {
      "id": "fixture-scheme",
      "primary": "#0F766E",
      "secondary": "#0F172A",
      "accent": "#F59E0B"
    },
    "fontScheme": {
      "id": "fixture-fonts",
      "heading": "Aptos Display",
      "body": "Aptos",
      "code": "Consolas"
    }
  },
  "slides": [
    {
      "beat": "contract",
      "title": "Catalog Overrides",
      "text": "Document-local catalog records can be referenced by id from the same OPF document."
    },
    {
      "beat": "proof",
      "title": "Local Chart Type",
      "chart": {
        "type": "line",
        "data": {
          "columns": [
            "Step",
            "Valid"
          ],
          "rows": [
            [
              "Read",
              1
            ],
            [
              "Resolve",
              1
            ],
            [
              "Render",
              1
            ]
          ]
        }
      }
    },
    {
      "beat": "decision",
      "title": "What This Proves",
      "items": [
        "Catalog source search paths are document-level configuration.",
        "Inline records are available before external catalogs.",
        "Object-form references can override resolved catalog records."
      ]
    }
  ],
  "catalogs": {
    "example": {
      "source": "pkg:@example/opf-catalog",
      "narratives": {
        "fixture-proof": {
          "name": "Fixture Proof",
          "beats": [
            {
              "id": "contract",
              "name": "Contract",
              "type": "text",
              "layout": "text-1x"
            },
            {
              "id": "proof",
              "name": "Proof",
              "type": "chart",
              "layout": "chart-1x"
            },
            {
              "id": "decision",
              "name": "Decision",
              "type": "list",
              "layout": "list-2x"
            }
          ]
        }
      }
    },
    "custom": {
      "themes": {
        "fixture-theme": {
          "name": "Fixture Theme",
          "colorScheme": "fixture-scheme",
          "fontScheme": "fixture-fonts"
        }
      },
      "colorSchemes": {
        "fixture-scheme": {
          "name": "Fixture Scheme",
          "accent1": "#0F766E",
          "accent2": "#0F172A",
          "accent3": "#F59E0B",
          "accent4": "#38BDF8",
          "accent5": "#A7F3D0",
          "accent6": "#FDBA74",
          "dark1": "#000000",
          "dark2": "#0F172A",
          "light1": "#FFFFFF",
          "light2": "#F8FAFC",
          "hyperlink": "#2563EB",
          "followedHyperlink": "#7C3AED"
        }
      },
      "fontSchemes": {
        "fixture-fonts": {
          "name": "Fixture Fonts",
          "major": "Aptos Display",
          "minor": "Aptos"
        }
      },
      "audiences": {
        "technical-reviewers": {
          "name": "Technical Reviewers",
          "technicalFluency": "high",
          "decisionPower": "advisory"
        }
      },
      "purposes": {
        "technical-approval": {
          "name": "Technical Approval",
          "outcome": "Approve the fixture contract"
        }
      },
      "tones": {
        "precise-plain": {
          "name": "Precise Plain",
          "voiceCues": [
            "Name the object shape before the rationale.",
            "Prefer short exact claims."
          ]
        }
      }
    }
  }
}
