        [
          "Proposal",
          27
        ],
        [
          "Won",
          11
        ]
      ],
      "datasource": "warehouse",
      "query": "SELECT stage, COUNT(*) FROM deals GROUP BY 1",
      "retrieved": "2026-11-24T06:00:00Z",
      "generator": {
        "type": "model",
        "name": "metricgen 2.1"
      }
    }
  },
  "slides": [
    {
