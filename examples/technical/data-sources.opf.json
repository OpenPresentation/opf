        ],
        [
          "Q4",
          31.2
        ]
      ],
      "datasource": "forecast",
      "query": "'Q3 plan'!A1:B5",
      "retrieved": "2026-11-01",
      "version": "r42",
      "sha256": "9f2c41b1d1b6e0a8a56e7c3d2f4b8a90c1e3d5f7a9b0c2d4e6f8a0b1c3d5e07a",
