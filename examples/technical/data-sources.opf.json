{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Data Sources",
  "description": "Technical fixture: data sources described once, datasets that say what they took, when and by whom, and a source line that names the same source.",
  "language": "en-US",
  "datasources": {
    "forecast": {
      "title": "FY26 forecast workbook",
