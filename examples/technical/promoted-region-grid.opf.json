{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Promoted Region Grid",
  "description": "Technical fixture for non-overlapping promoted region keys and span combinations.",
  "language": "en-US",
  "slides": [
    {
      "title": "Column Spans",
      "blocks": [
        {
          "region": "start",
          "text": "Left column"
        },
        {
          "region": "center+end",
          "items": [
            "Center and right span",
            "No overlap with left"
          ]
        }
      ]
    },
    {
      "title": "Row Spans",
      "blocks": [
        {
          "region": "top+middle",
          "chart": {
            "type": "area",
            "data": {
              "columns": [
                "Month",
                "Volume"
              ],
              "rows": [
                [
                  "Jan",
                  10
                ],
                [
                  "Feb",
                  18
                ],
                [
                  "Mar",
                  24
                ]
              ]
            }
          }
        },
        {
          "region": "bottom",
          "quote": "The bottom row remains available for interpretation."
        }
      ]
    },
    {
      "title": "Grid Cells",
      "blocks": [
        {
          "region": "top:start",
          "metric": {
            "value": 42,
            "label": "Inputs"
          }
        },
        {
          "region": "top:center",
          "metric": {
            "value": 18,
            "label": "Routes"
          }
        },
        {
          "region": "top:end",
          "metric": {
            "value": 9,
            "label": "Escalations"
          }
        },
        {
          "region": "middle+bottom:start+center+end",
          "timeline": [
            {
              "when": "Now",
              "what": "Observe"
            },
            {
              "when": "Next",
              "what": "Route"
            },
            {
              "when": "Then",
              "what": "Resolve"
            }
          ]
        }
      ]
    }
  ]
}
