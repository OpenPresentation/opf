{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "A delivery timeline with proportional periods",
  "description": "Explicit numeric durations preserve the authored time labels and draw consecutive periods at their relative lengths.",
  "design": {
    "theme": "classic",
    "variant": "light1",
    "fontScheme": "roboto"
  },
  "slides": [
    {
      "id": "six-week-delivery",
      "layout": "timeline",
      "title": "Four weeks build on one week of discovery",
      "timeline": {
        "name": "Six-week delivery",
        "events": [
          {
            "when": "Week 1",
            "what": "Discover",
            "description": "Agree the scope.",
            "duration": 1,
            "status": "done"
          },
          {
            "when": "Weeks 2–5",
            "what": "Build",
            "description": "Deliver and test the working product.",
            "duration": 4,
            "status": "current"
          },
          {
            "when": "Week 6",
            "what": "Launch",
            "description": "Release to the team.",
            "status": "planned"
          }
        ]
      }
    }
  ],
  "catalogs": {
    "default": {
      "source": "https://www.pptx.gallery",
      "themes": {
        "classic": {
          "name": "Classic",
          "background": {
            "type": "theme",
            "slot": "light1"
          },
          "colorScheme": "cool-horizon",
          "description": "A timeless, clean, and versatile theme with balanced color contrasts and classic typography. Ideal for professional, readable presentations.",
          "fontScheme": "tenorite",
          "dimensions": "widescreen",
          "variants": [
            {
              "id": "light",
              "name": "Light",
              "variant": "light1"
            },
            {
              "id": "light-alt",
              "name": "Light alt",
              "variant": {
                "background": "light1",
                "accents": [
                  "accent6",
                  "accent5",
                  "accent4",
                  "accent1",
                  "accent3",
                  "accent2"
                ]
              }
            },
            {
              "id": "dark",
              "name": "Dark",
              "variant": "dark1"
            },
            {
              "id": "dark-alt",
              "name": "Dark alt",
              "variant": {
                "background": "dark1",
                "accents": [
                  "accent6",
                  "accent5",
                  "accent4",
                  "accent1",
                  "accent3",
                  "accent2"
                ]
              }
            }
          ]
        }
      },
      "fontSchemes": {
        "roboto": {
          "name": "Roboto",
          "app": "google-slides",
          "languageFamily": "latin",
          "languages": [],
          "major": "Roboto",
          "minor": "Roboto",
          "textSample": "Perfect for tech",
          "type": "sans-serif",
          "description": "Roboto is a sans serif OPF font scheme for Latin presentations, using Roboto for both headings and body text."
        },
        "tenorite": {
          "name": "Tenorite",
          "app": "powerpoint",
          "languageFamily": "latin",
          "languages": [],
          "major": "Tenorite Display",
          "minor": "Tenorite",
          "textSample": "Rounded modern tone",
          "type": "sans-serif",
          "description": "Tenorite is a sans serif OPF font scheme for Latin presentations, using Tenorite Display for headings with Tenorite for body text."
        }
      },
      "layouts": {
        "timeline": {
          "name": "Timeline",
          "summary": "Dated events or a roadmap along one axis, with optional notes.",
          "tags": [
            "Groups of items"
          ],
          "direction": "column",
          "regions": [
            {
              "name": "title"
            },
            {
              "name": "lead",
              "size": "auto",
              "accepts": [
                "text"
              ],
              "role": "supporting",
              "flow": "none"
            },
            {
              "name": "timeline",
              "accepts": [
                "timeline",
                "diagram"
              ],
              "role": "primary",
              "flow": "column"
            },
            {
              "name": "notes",
              "size": "auto",
              "accepts": [
                "text",
                "list",
                "metric"
              ],
              "role": "supporting",
              "flow": "auto"
            }
          ],
          "description": "Show events or milestones in chronological order. Label each item with a date or stage and a concise description.",
          "preview": {
            "vectorSrc": "https://www.pptx.gallery/layout-previews/timeline.svg"
          }
        }
      },
      "colorSchemes": {
        "cool-horizon": {
          "name": "Cool Horizon",
          "accent1": "#2874A6",
          "accent2": "#1B4F72",
          "accent3": "#5499C7",
          "accent4": "#7BDBB2",
          "accent5": "#3AC67A",
          "accent6": "#24A89E",
          "dark1": "#000000",
          "dark2": "#011842",
          "followedHyperlink": "#551A8B",
          "hyperlink": "#0000EE",
          "light1": "#FFFFFF",
          "light2": "#F0F0F0",
          "summary": "Cool blue-green palette tuned for professional business decks.",
          "description": "A balanced cool-toned scheme with deep navy, business blues, and teal accents. It works well across strategy, finance, and technical narratives.",
          "tags": [
            "professional",
            "trustworthy",
            "calm",
            "technical",
            "versatile"
          ]
        }
      }
    }
  }
}
