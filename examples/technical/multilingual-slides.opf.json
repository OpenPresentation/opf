{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "One deck, several languages",
  "description": "Slide-level language controls direction, script fonts, quotations and number formatting while the deck keeps its shared design.",
  "language": "en-US",
  "design": {
    "theme": "minimal",
    "fontScheme": "aptos"
  },
  "slides": [
    {
      "title": "One design, several languages",
      "text": "Each slide can choose its language. Slides that omit it inherit the deck language."
    },
    {
      "language": {
        "bcp47": "ar-SA",
        "fontScheme": "noto-sans-arabic"
      },
      "title": "لغة الشريحة تحدد اتجاهها",
      "items": [
        "تقرأ هذه الشريحة من اليمين إلى اليسار",
        "يكتب التصدير خط العربية المختار",
        "تحتفظ الشرائح الأخرى بلغتها"
      ]
    },
    {
      "language": "ja",
      "title": "スライドごとに言語を選ぶ",
      "quote": "同じ資料でも、それぞれの言語に合う文字と引用符を使う。"
    },
    {
      "language": "fr-FR",
      "title": "Chaque langue garde ses conventions",
      "metric": {
        "value": 150000,
        "label": "Personnes accompagnées",
        "description": "Les nombres suivent la langue de cette diapositive."
      }
    }
  ],
  "catalogs": {
    "default": {
      "source": "https://www.pptx.gallery",
      "themes": {
        "minimal": {
          "name": "Minimal",
          "background": {
            "type": "theme",
            "slot": "dark2"
          },
          "colorScheme": "cool-horizon",
          "description": "A clean, minimalistic theme with a focus on simplicity and readability. Ideal for professional, straightforward presentations.",
          "fontScheme": "aptos",
          "dimensions": "widescreen",
          "variants": [
            {
              "id": "light",
              "name": "Light",
              "variant": "light1"
            },
            {
              "id": "light-alt",
              "name": "Light alt",
              "variant": {
                "background": "light1",
                "accents": [
                  "accent6",
                  "accent5",
                  "accent4",
                  "accent1",
                  "accent3",
                  "accent2"
                ]
              }
            },
            {
              "id": "dark",
              "name": "Dark",
              "variant": "dark2"
            },
            {
              "id": "dark-alt",
              "name": "Dark alt",
              "variant": {
                "background": "dark2",
                "accents": [
                  "accent6",
                  "accent5",
                  "accent4",
                  "accent1",
                  "accent3",
                  "accent2"
                ]
              }
            }
          ]
        }
      },
      "fontSchemes": {
        "aptos": {
          "name": "Aptos",
          "app": "powerpoint",
          "languageFamily": "latin",
          "languages": [],
          "major": "Aptos Display",
          "minor": "Aptos",
          "textSample": "Modern clean design",
          "type": "sans-serif",
          "description": "Aptos is a sans serif OPF font scheme for Latin presentations, using Aptos Display for headings with Aptos for body text."
        },
        "noto-sans-arabic": {
          "name": "Noto Sans Arabic",
          "app": "google-slides",
          "languageFamily": "cs",
          "languages": [
            "ar",
            "ps",
            "pa-Arab"
          ],
          "major": "Noto Naskh Arabic",
          "minor": "Noto Naskh Arabic",
          "textSample": "نص عربي أنيق",
          "type": "sans-serif",
          "description": "Noto Sans Arabic is a sans serif OPF font scheme for complex script presentations, using Noto Naskh Arabic for both headings and body text."
        }
      },
      "colorSchemes": {
        "cool-horizon": {
          "name": "Cool Horizon",
          "accent1": "#2874A6",
          "accent2": "#1B4F72",
          "accent3": "#5499C7",
          "accent4": "#7BDBB2",
          "accent5": "#3AC67A",
          "accent6": "#24A89E",
          "dark1": "#000000",
          "dark2": "#011842",
          "followedHyperlink": "#551A8B",
          "hyperlink": "#0000EE",
          "light1": "#FFFFFF",
          "light2": "#F0F0F0",
          "summary": "Cool blue-green palette tuned for professional business decks.",
          "description": "A balanced cool-toned scheme with deep navy, business blues, and teal accents. It works well across strategy, finance, and technical narratives.",
          "tags": [
            "professional",
            "trustworthy",
            "calm",
            "technical",
            "versatile"
          ]
        }
      }
    }
  }
}
