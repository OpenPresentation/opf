{
  "$schema": "https://openpresentation.org/schema/opf/v1",
  "name": "Header Footer Logo Set",
  "description": "Technical fixture for organization logo shapes (onLight and onDark), logo references in header and footer zones, a zone row (logo beside text), repeated furniture, and watermark suppression.",
  "organization": {
    "id": "fixture-org",
    "name": "Fixture Org",
    "logo": {
      "full": {
        "onLight": "asset:logo-dark",
        "onDark": "asset:logo-light"
      },
      "icon": "asset:icon",
      "wordmark": "asset:wordmark"
    }
  },
  "design": {
    "header": {
      "left": {
        "image": "var:organization.logo.icon"
      },
      "center": {
        "text": "{{slide.section}}"
      },
      "right": {
        "date": "2026-05-05"
      }
    },
    "footer": {
      "left": {
        "image": "var:organization.logo.icon",
        "text": "{{organization.name}}"
      },
      "center": {
        "text": "Confidential fixture"
      },
      "right": {
        "text": "{{slide.number}}"
      }
    },
    "watermark": {
      "src": "asset:watermark",
      "opacity": 0.05
    }
  },
  "slides": [
    {
      "section": "Default Furniture",
      "title": "Header And Footer",
      "text": "The deck-level header, footer, organization logo and watermark apply by default; the footer zone draws the logo icon beside the organization name."
    },
    {
      "section": "Suppressed Furniture",
      "title": "Slide Override",
      "design": {
        "header": false,
        "footer": false,
        "watermark": false
      },
      "text": "Slide-level design can suppress inherited repeated furniture."
    }
  ],
  "assets": {
    "logo-dark": "./assets/logo-dark.svg",
    "logo-light": "./assets/logo-light.svg",
    "icon": "./assets/icon.svg",
    "wordmark": "./assets/wordmark.svg",
    "watermark": "./assets/watermark.png"
  }
}
